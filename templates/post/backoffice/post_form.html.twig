{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ title }} - Backoffice{% endblock %}

{% block backoffice_content %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
<style>
.dashboard-sidebar {
    position: sticky;
    top: 0;
    align-self: flex-start;
    max-height: 100vh;
}

.post-form-shell {
    padding: 18px 16px;
}

.post-form-card {
    max-width: 820px;
    margin: 0 auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
}

.post-form-header {
    margin-bottom: 14px;
}

.post-form-title {
    margin: 0;
    color: var(--text);
    font-size: 22px;
    font-weight: 800;
}

.post-form-note {
    color: var(--muted);
    font-size: 13px;
    margin: 4px 0 0;
}

.post-form-intro {
    margin-bottom: 18px;
    padding: 14px 16px;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
}

.form-grid-two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.post-form-row {
    margin-bottom: 16px;
}

.post-form-field {
    display: flex;
    flex-direction: column;
}

.post-form-help {
    margin-top: -2px;
    color: var(--muted);
    font-size: 12px;
}

.post-file-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border-radius: 14px;
    border: 1px dashed rgba(139, 92, 246, 0.38);
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.92), rgba(15, 23, 42, 0.92));
}

.post-file-top {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.post-file-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(139, 92, 246, 0.16);
    color: #d8b4fe;
    font-size: 16px;
}

.post-file-meta strong {
    display: block;
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
}

.post-file-meta span {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.45;
}

.post-file-box input[type="file"] {
    width: 100%;
    color: #e5e7eb;
    background: #0f172a;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 12px;
}

.post-file-box input[type="file"]::file-selector-button {
    margin-right: 12px;
    border: none;
    border-radius: 10px;
    padding: 9px 12px;
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
}

.post-file-selected {
    color: #cbd5e1;
    font-size: 12px;
}

.post-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
}

.form-control,
.form-select {
    background: #0f172a;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 10px;
}

.form-control:focus,
.form-select:focus {
    background: #0f172a;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.18);
    color: var(--text);
}

.form-label {
    color: var(--text);
    font-weight: 700;
}

.form-check-input {
    background: #0f172a;
    border-color: var(--border);
}

.form-check-input:checked {
    background-color: var(--accent);
    border-color: var(--accent);
}

.btn-cancel-post {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #111827;
    color: var(--muted);
    font-weight: 700;
    text-decoration: none;
}

.btn-cancel-post:hover {
    color: #fff;
    border-color: #8b5cf6;
    background: #1a1f2e;
}

.btn-save-post {
    border: none;
    padding: 10px 18px;
    border-radius: 10px;
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #fff;
    font-weight: 800;
    box-shadow: 0 8px 22px rgba(124, 58, 237, 0.22);
}

.btn-save-post:hover {
    background: linear-gradient(135deg, #9333ea, #7c3aed);
}

.current-post-image {
    margin-top: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: #0f172a;
}

.current-post-image img {
    display: block;
    width: 100%;
    max-height: 260px;
    object-fit: cover;
}

.current-post-image span {
    display: block;
    padding: 10px 12px;
    color: var(--muted);
    font-size: 12px;
}

.post-form-publish {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
}

.post-form-publish .form-check {
    margin: 0;
}

.post-form-publish .form-check-label {
    color: var(--text);
    font-weight: 700;
}

@media (max-width: 768px) {
    .form-grid-two {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="post-form-shell">
    <div class="post-form-card">
        <div class="post-form-header">
            <h2 class="post-form-title"><i class="bi bi-pencil-square"></i> {{ title }}</h2>
            <p class="post-form-note">Remplissez les champs ci-dessous. Les champs marqués <span style="color:#ef4444;">*</span> sont obligatoires.</p>
        </div>

        <div class="post-form-intro">
            Choisissez un titre simple et lisible, sélectionnez le type de votre post et sa visibilité, puis ajoutez une image si besoin.
        </div>

        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger" style="background:#450a0a;color:#fca5a5;border:1px solid #7f1d1d;border-radius:8px;padding:10px 14px;margin-bottom:14px;">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="post-form-row">
            <div class="post-form-field">
                {{ form_row(form.title, {
                    label: 'Titre <span style="color:#ef4444;">*</span>',
                    label_html: true
                }) }}
            </div>
        </div>

        <div class="post-form-row form-grid-two">
            <div class="post-form-field">
                {{ form_row(form.type, {
                    label: 'Type <span style="color:#ef4444;">*</span>',
                    label_html: true
                }) }}
            </div>

            <div class="post-form-field">
                {{ form_row(form.visibility, {
                    label: 'Visibilité <span style="color:#ef4444;">*</span>',
                    label_html: true
                }) }}
            </div>
        </div>

        <div class="post-form-row">
            <div class="post-form-field">
                {{ form_label(form.imageFile, 'Image du post') }}
                <div class="post-file-box">
                    <div class="post-file-top">
                        <div class="post-file-icon"><i class="bi bi-image"></i></div>
                        <div class="post-file-meta">
                            <strong>Choisissez une image depuis votre PC</strong>
                            <span>Formats conseillés : JPG, PNG ou WEBP.</span>
                        </div>
                    </div>
                    {{ form_widget(form.imageFile, {'attr': {'class': 'post-file-native', 'data-file-input': 'true'}}) }}
                    <div class="post-file-selected" data-file-selected>Aucun fichier sélectionné.</div>
                    {{ form_errors(form.imageFile) }}
                </div>
            </div>
        </div>

        {% if form.vars.data and form.vars.data.imageUrl %}
            {% set currentImageSrc = form.vars.data.imageUrl starts with 'http' ? form.vars.data.imageUrl : asset(form.vars.data.imageUrl) %}
            <div class="current-post-image">
                <img src="{{ currentImageSrc }}" alt="Image actuelle du post">
                <span>Image actuelle conservée tant qu'aucun nouveau fichier n'est choisi.</span>
            </div>
        {% endif %}

        <div class="post-form-row" style="margin-top:14px;">
            {{ form_row(form.content, {
                label: 'Contenu <span style="color:#ef4444;">*</span>',
                label_html: true
            }) }}
        </div>

        {% if form.is_published is defined %}
            <div class="post-form-publish">
                {{ form_row(form.is_published, {
                    label: 'Publier ?',
                    label_html: true
                }) }}
            </div>
        {% endif %}

        <div class="post-form-actions">
            <a class="btn-cancel-post" href="{{ path('app_backoffice_posts_list') }}">Annuler</a>
            <button class="btn-save-post" type="submit"><i class="bi bi-check-lg"></i> Enregistrer</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
document.querySelectorAll('[data-file-input]').forEach(function (input) {
    const fileBox = input.closest('.post-file-box');
    const selected = fileBox ? fileBox.querySelector('[data-file-selected]') : null;
    if (!selected) {
        return;
    }

    input.addEventListener('change', function () {
        const file = input.files && input.files[0] ? input.files[0].name : '';
        selected.textContent = file !== '' ? 'Fichier choisi : ' + file : 'Aucun fichier sélectionné.';
    });
});
</script>
{% endblock %}
