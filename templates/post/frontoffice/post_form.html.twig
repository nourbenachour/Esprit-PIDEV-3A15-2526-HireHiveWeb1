{% extends 'user/frontoffice/index.html.twig' %}

{% block title %}{{ title }} - HireHive{% endblock %}

{% block frontoffice_content %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
<style>
.front-post-form-shell{max-width:820px;margin:0 auto;padding:18px 16px 40px}
.front-post-form-card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:26px;box-shadow:0 14px 34px rgba(15,23,42,.05)}
.front-post-form-header{margin-bottom:14px}.front-post-form-title{margin:0;color:#111827;font-size:22px;font-weight:800}.front-post-form-note{color:#6b7280;font-size:13px;margin:4px 0 0}
.front-post-form-intro{margin-bottom:18px;padding:14px 16px;border-radius:12px;background:#f8fafc;border:1px solid #e5e7eb;color:#6b7280;font-size:13px;line-height:1.55}
.front-grid-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.front-row{margin-bottom:16px}.front-field{display:flex;flex-direction:column}.front-help{margin-top:-2px;color:#6b7280;font-size:12px}
.front-post-form-card .form-control,.front-post-form-card .form-select{background:#fff;border:1px solid #d1d5db;color:#111827;border-radius:10px}
.front-post-form-card .form-control:focus,.front-post-form-card .form-select:focus{background:#fff;border-color:#8b5cf6;box-shadow:0 0 0 2px rgba(139,92,246,.14);color:#111827}
.front-post-form-card .form-label{color:#111827;font-weight:700}
.front-file-box{display:flex;flex-direction:column;gap:8px;padding:14px;border-radius:14px;border:1px dashed rgba(139,92,246,.35);background:#faf5ff}
.front-file-top{display:flex;align-items:flex-start;gap:10px}.front-file-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:rgba(139,92,246,.12);color:#7c3aed;font-size:16px}
.front-file-meta strong{display:block;color:#111827;font-size:13px;font-weight:800}.front-file-meta span{display:block;margin-top:2px;color:#6b7280;font-size:11px;line-height:1.45}
.front-file-box input[type=file]{width:100%;color:#111827;background:#fff;border:1px solid #d1d5db;border-radius:12px;padding:10px 12px}
.front-file-box input[type=file]::file-selector-button{margin-right:12px;border:none;border-radius:10px;padding:9px 12px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;font-size:13px;font-weight:800;cursor:pointer}
.front-file-selected{color:#4b5563;font-size:12px}
.front-current-image{margin-top:12px;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff}.front-current-image img{display:block;width:100%;max-height:260px;object-fit:cover}.front-current-image span{display:block;padding:10px 12px;color:#6b7280;font-size:12px}
.front-form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;padding-top:14px;border-top:1px solid #e5e7eb}.front-btn-cancel{padding:10px 18px;border-radius:10px;border:1px solid #d1d5db;background:#fff;color:#6b7280;font-weight:700;text-decoration:none}.front-btn-cancel:hover{border-color:#8b5cf6;background:#f9fafb;color:#111827}.front-btn-save{border:none;padding:10px 18px;border-radius:10px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;font-weight:800}
@media (max-width:768px){.front-grid-two{grid-template-columns:1fr}}
</style>

<div class="front-post-form-shell">
    <div class="front-post-form-card">
        <div class="front-post-form-header">
            <h2 class="front-post-form-title"><i class="bi bi-pencil-square" style="color:#7c3aed;"></i> {{ title }}</h2>
            <p class="front-post-form-note">Remplissez les champs ci-dessous pour publier votre post.</p>
        </div>


        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}" style="border-radius:10px;margin-bottom:12px;">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if form.vars.errors|length > 0 %}
            <div style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-bottom:14px;">{{ form_errors(form) }}</div>
        {% endif %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="front-row">
                <div class="front-field">
                    {{ form_row(form.title, {label: 'Titre <span style="color:#ef4444;">*</span>', label_html: true}) }}
                </div>
            </div>

            <div class="front-row front-grid-two">
                <div class="front-field">
                    {{ form_row(form.type, {label: 'Type <span style="color:#ef4444;">*</span>', label_html: true}) }}
                </div>
                <div class="front-field">
                    {{ form_row(form.visibility, {label: 'Visibilite <span style="color:#ef4444;">*</span>', label_html: true}) }}
                </div>
            </div>

            <div class="front-row">
                <div class="front-field">
                    {{ form_label(form.imageFile, 'Image du post') }}
                    <div class="front-file-box">
                        <div class="front-file-top">
                            <div class="front-file-icon"><i class="bi bi-image"></i></div>
                            <div class="front-file-meta">
                                <strong>Choisissez une image depuis votre PC</strong>
                                <span>Formats conseilles : JPG, PNG ou WEBP.</span>
                            </div>
                        </div>
                        {{ form_widget(form.imageFile, {'attr': {'data-file-input': 'true'}}) }}
                        <div class="front-file-selected" data-file-selected>Aucun fichier selectionne.</div>
                        {{ form_errors(form.imageFile) }}
                    </div>
                </div>
            </div>

            {% if form.vars.data and form.vars.data.imageUrl %}
                {% set rawCurrentImage = form.vars.data.imageUrl %}
                {% set canRenderCurrentImage = rawCurrentImage starts with 'http' or rawCurrentImage starts with '/uploads/' or rawCurrentImage starts with 'uploads/' %}
                {% if canRenderCurrentImage %}
                {% set currentImageSrc = rawCurrentImage starts with 'http' ? rawCurrentImage : asset(rawCurrentImage starts with '/' ? rawCurrentImage|slice(1) : rawCurrentImage) %}
                <div class="front-current-image">
                    <img src="{{ currentImageSrc }}" alt="Image actuelle du post">
                    <span>Image actuelle conservee tant qu'aucun nouveau fichier n'est choisi.</span>
                </div>
                {% endif %}
            {% endif %}

            <div class="front-row" style="margin-top:14px;">
                {{ form_row(form.content, {label: 'Contenu <span style="color:#ef4444;">*</span>', label_html: true}) }}
            </div>

            <div class="front-form-actions">
                <a class="front-btn-cancel" href="{{ path('app_frontoffice_feed') }}">Annuler</a>
                <button class="front-btn-save" type="submit"><i class="bi bi-check-lg"></i> Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
document.querySelectorAll('[data-file-input]').forEach(function(input){const box=input.closest('.front-file-box');const selected=box?box.querySelector('[data-file-selected]'):null;if(!selected){return;}input.addEventListener('change',function(){const file=input.files&&input.files[0]?input.files[0].name:'';selected.textContent=file!==''?'Fichier choisi : '+file:'Aucun fichier selectionne.';});});
</script>
{% endblock %}
