{% extends 'user/frontoffice/index.html.twig' %}

{% block title %}Feed - HireHive{% endblock %}

{% block frontoffice_content %}
{% set currentUser = app.user %}
{% set userInitials = currentUser ? (currentUser.firstName|default('H'))|first ~ (currentUser.lastName|default('H'))|first : 'HH' %}
<style>
.ff-page{background:#f8fafc;min-height:calc(100vh - 80px);padding:28px 18px 44px}.ff-shell{max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
.ff-card,.ff-post,.ff-composer{background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 10px 28px rgba(15,23,42,.05)}.ff-post{overflow:visible}
.ff-flash{padding:12px 14px;border-radius:12px;font-size:13px;font-weight:700;transition:opacity .28s ease,transform .28s ease}.ff-flash.is-hiding{opacity:0;transform:translateY(-8px)}.ff-flash-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#166534}.ff-flash-danger{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c}
.ff-composer{padding:16px 18px 12px}.ff-composer-top{display:flex;align-items:center;gap:12px}.ff-avatar,.ff-post-avatar,.ff-comment-avatar{border-radius:50%;display:grid;place-items:center;font-weight:800;flex-shrink:0}.ff-avatar{width:48px;height:48px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;font-size:18px}
.ff-composer-link{flex:1;height:48px;border-radius:999px;border:1px solid #d1d5db;background:#f8fafc;display:flex;align-items:center;padding:0 18px;color:#6b7280;font-size:15px;font-weight:700;text-decoration:none}.ff-composer-link:hover{background:#fff;border-color:#8b5cf6;color:#374151}
.ff-composer-actions{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}.ff-composer-actions a{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border-radius:10px;color:#6b7280;font-size:13px;font-weight:700;text-decoration:none}.ff-composer-actions a:hover{background:#f5f3ff;color:#7c3aed}
.ff-sort{display:flex;align-items:center;gap:12px;color:#6b7280;font-size:13px}.ff-sort-line{flex:1;height:1px;background:#e5e7eb}.ff-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 220px auto;gap:12px;padding:14px 16px}
.ff-search,.ff-select{width:100%;height:44px;border-radius:10px;border:1px solid #d1d5db;background:#fff;color:#111827;padding:0 14px;font-size:14px}.ff-search:focus,.ff-select:focus,.ff-edit textarea:focus,.ff-comment-form textarea:focus,.ff-comment-form textarea.is-targeted-field{outline:none;border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(139,92,246,.14)}.ff-toolbar-actions{display:flex;align-items:center;gap:10px}.ff-toolbar-btn,.ff-toolbar-link{height:44px;border-radius:10px;padding:0 16px;font-size:13px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;text-decoration:none}.ff-toolbar-btn{border:1px solid #7c3aed;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff}.ff-toolbar-link{border:1px solid #d1d5db;background:#fff;color:#4b5563}
.ff-post-header{display:flex;align-items:flex-start;gap:12px;padding:16px 16px 12px}.ff-post-avatar{width:50px;height:50px;background:linear-gradient(135deg,#8b5cf6,#a78bfa);color:#fff;font-size:18px}.ff-post-main{flex:1;min-width:0}
.ff-post-name-row,.ff-comment-name-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ff-post-name,.ff-comment-name{color:#111827;font-size:15px;font-weight:800}.ff-meta{margin-top:4px;color:#6b7280;font-size:12px;line-height:1.5}
.ff-badge-admin,.ff-badge-role,.ff-badge-vis,.ff-badge-soft{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:800}.ff-badge-admin{background:rgba(139,92,246,.14);color:#7c3aed}.ff-badge-role{background:#f3f4f6;color:#4b5563}.ff-badge-vis{background:#ecfdf5;color:#166534}.ff-badge-soft{background:#f3f4f6;color:#6b7280}
.ff-menu-wrap{position:relative}.ff-icon-btn{width:34px;height:34px;border:none;background:transparent;border-radius:50%;color:#6b7280}.ff-icon-btn:hover{background:#f5f3ff;color:#7c3aed}
.ff-menu{position:absolute;top:40px;right:0;min-width:180px;padding:8px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;box-shadow:0 18px 38px rgba(15,23,42,.12);display:none;z-index:20}.ff-menu.is-open{display:block}.ff-menu form,.ff-menu button,.ff-menu a{width:100%}
.ff-menu-action{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:9px;border:none;background:transparent;color:#374151;text-align:left;font-size:13px;font-weight:700;text-decoration:none}.ff-menu-action:hover{background:#f5f3ff;color:#7c3aed}.ff-menu-action.is-danger{color:#dc2626}
.ff-reaction-menu{top:auto;right:auto;left:-2px;bottom:calc(100% + 10px);min-width:auto;padding:10px 12px;border-radius:999px;background:rgba(255,255,255,.98);border-color:#ddd6fe}.ff-reaction-options{display:flex;align-items:center;gap:12px}.ff-reaction-menu form,.ff-reaction-menu button{width:auto!important}
.ff-reaction-pill{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:50%;border:none;color:#fff;font-size:22px;box-shadow:0 12px 24px rgba(15,23,42,.16);transition:transform .16s ease}.ff-reaction-pill:hover{transform:translateY(-2px) scale(1.04)}.ff-reaction-pill.like{background:linear-gradient(180deg,#60a5fa,#2563eb)}.ff-reaction-pill.love{background:linear-gradient(180deg,#fb7185,#e11d48)}.ff-reaction-pill.dislike{background:linear-gradient(180deg,#f59e0b,#d97706)}
.ff-post-body{padding:0 16px 14px}.ff-post-title{margin:0 0 8px;font-size:16px;color:#111827;font-weight:800}.ff-post-text{margin:0;color:#374151;font-size:14px;line-height:1.65;word-break:break-word}.ff-post-image{display:block;width:100%;max-height:430px;object-fit:cover;margin-top:12px;border-top:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;background:#f8fafc}
.ff-stats{display:flex;justify-content:space-between;gap:12px;padding:10px 16px;color:#6b7280;font-size:13px}.ff-stats-left,.ff-stats-right{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.ff-divider{margin:0 16px;height:1px;background:#e5e7eb}
.ff-actions{display:flex;align-items:center;gap:6px;padding:8px 12px 10px}.ff-action-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;border-radius:10px;border:none;background:transparent;color:#4b5563;font-size:14px;font-weight:700}.ff-action-btn:hover{background:#f5f3ff;color:#7c3aed}
.ff-comments{padding:0 16px 16px}.ff-comments-list{display:flex;flex-direction:column;gap:16px;margin-top:8px}.ff-comment-item{display:flex;gap:10px;align-items:flex-start}.ff-comment-avatar{width:36px;height:36px;background:#ede9fe;color:#7c3aed;font-size:12px}.ff-comment-main{flex:1;min-width:0;padding-top:1px}
.ff-comment-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px}.ff-comment-top-right{display:flex;align-items:center;gap:4px;flex-shrink:0}.ff-comment-bubble{background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:10px 12px}.ff-comment-text{margin:4px 0 0;color:#374151;font-size:13px;line-height:1.55}.ff-comment-date{color:#9ca3af;font-size:12px}
.ff-edit{display:none;gap:8px;margin-top:8px}.ff-edit.is-open{display:flex}.ff-edit textarea,.ff-comment-form textarea{flex:1;min-height:44px;resize:vertical;border:1px solid #d1d5db;border-radius:10px;background:#fff;color:#111827;padding:10px 12px;font-size:13px;line-height:1.5}.ff-edit button,.ff-comment-form button{align-self:flex-end;border:none;border-radius:999px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;padding:10px 16px;font-size:13px;font-weight:800}
.ff-comment-composer{display:flex;gap:10px;margin-top:14px}.ff-comment-composer.is-targeted .ff-comment-form textarea{border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(139,92,246,.14)}.ff-comment-form{flex:1;display:flex;gap:8px;align-items:flex-end}.ff-comment-submit.is-hidden,.ff-post.is-hidden{display:none}
.ff-empty{padding:20px 16px;color:#6b7280;font-size:13px;text-align:center}.ff-empty-feed{text-align:center;padding:60px 20px;color:#6b7280;font-size:15px;border:1px dashed #d1d5db;border-radius:16px;background:#fff}
.ff-modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.35);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px;z-index:80}.ff-modal-backdrop.is-open{display:flex}.ff-modal{width:min(100%,420px);background:#fff;border:1px solid #e5e7eb;border-radius:18px;box-shadow:0 30px 60px rgba(15,23,42,.15);overflow:hidden}.ff-modal-head{display:flex;align-items:center;gap:12px;padding:18px 20px 10px}.ff-modal-icon{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:rgba(139,92,246,.12);color:#7c3aed;font-size:18px}.ff-modal-title{margin:0;color:#111827;font-size:17px;font-weight:800}.ff-modal-body{padding:0 20px 18px;color:#4b5563;font-size:14px;line-height:1.65}.ff-modal-actions{display:flex;justify-content:flex-end;gap:10px;padding:0 20px 20px}.ff-modal-btn{border:none;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:800}.ff-modal-btn-secondary{background:#f3f4f6;color:#374151}.ff-modal-btn-danger{background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff}
@media (max-width:900px){.ff-toolbar{grid-template-columns:1fr}.ff-comment-form,.ff-edit{flex-direction:column;align-items:stretch}.ff-edit button,.ff-comment-form button{align-self:stretch}}
</style>

<div class="ff-page"><div class="ff-shell">
{% for label, messages in app.flashes %}{% for message in messages %}<div class="ff-flash {{ label == 'success' ? 'ff-flash-success' : 'ff-flash-danger' }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="ff-composer"><div class="ff-composer-top"><div class="ff-avatar">{{ userInitials|upper }}</div><a href="{{ path('app_frontoffice_post_new') }}" class="ff-composer-link">Commencer un post</a></div><div class="ff-composer-actions"><a href="{{ path('app_frontoffice_post_new') }}"><i class="bi bi-play-btn-fill"></i> Video</a><a href="{{ path('app_frontoffice_post_new') }}"><i class="bi bi-image-fill"></i> Photo</a><a href="{{ path('app_frontoffice_post_new') }}"><i class="bi bi-pencil-square"></i> Article</a></div></section>
<div class="ff-sort"><div class="ff-sort-line"></div></div>
<form method="get" action="{{ path('app_frontoffice_feed') }}" class="ff-composer ff-toolbar"><input type="search" name="q" class="ff-search" placeholder="Rechercher par titre ou contenu..." value="{{ searchTerm|default('') }}"><select name="sort" class="ff-select"><option value="newest" {{ currentSort == 'newest' ? 'selected' : '' }}>Plus recent</option><option value="oldest" {{ currentSort == 'oldest' ? 'selected' : '' }}>Plus ancien</option><option value="title-asc" {{ currentSort == 'title-asc' ? 'selected' : '' }}>Titre A a Z</option><option value="title-desc" {{ currentSort == 'title-desc' ? 'selected' : '' }}>Titre Z a A</option><option value="comments-desc" {{ currentSort == 'comments-desc' ? 'selected' : '' }}>Commentaires</option><option value="reactions-desc" {{ currentSort == 'reactions-desc' ? 'selected' : '' }}>Reactions</option></select><div class="ff-toolbar-actions"><button type="submit" class="ff-toolbar-btn">Rechercher</button>{% if searchTerm or currentSort != 'newest' %}<a href="{{ path('app_frontoffice_feed') }}" class="ff-toolbar-link">Reinitialiser</a>{% endif %}</div></form>

{% for post in posts %}
{% set author = post.id_user %}{% set authorRole = author ? author.role|upper : 'UNKNOWN' %}{% set authorInitials = author ? (author.firstName|default('?'))|first ~ (author.lastName|default('?'))|first : '??' %}{% set isOwnPost = currentUser and author and currentUser.id == author.id %}{% set isAdminPost = authorRole == 'ADMIN' or authorRole == 'ROLE_ADMIN' %}{% set likes = post.reactions|filter(r => r.reactionType == 'LIKE')|length %}{% set loves = post.reactions|filter(r => r.reactionType == 'LOVE')|length %}{% set dislikes = post.reactions|filter(r => r.reactionType == 'DISLIKE')|length %}{% set totalPostReactions = likes + loves + dislikes %}
<article class="ff-post" data-post-id="{{ post.idPost }}">
<div class="ff-post-header"><div class="ff-post-avatar">{{ authorInitials|upper }}</div><div class="ff-post-main"><div class="ff-post-name-row"><span class="ff-post-name">{{ author ? author.firstName ~ ' ' ~ author.lastName : 'Utilisateur inconnu' }}</span>{% if isAdminPost %}<span class="ff-badge-admin"><i class="bi bi-shield-fill-check"></i> Admin</span>{% else %}<span class="ff-badge-role">{{ authorRole|replace({'ROLE_': ''}) }}</span>{% endif %}<span class="ff-badge-vis">{{ post.visibility }}</span></div><div class="ff-meta"> {{ post.createdAt|date('d/m/Y H:i') }}</div></div>{% if isOwnPost %}<div class="ff-menu-wrap"><button type="button" class="ff-icon-btn" data-menu-toggle="post-menu-{{ post.idPost }}"><i class="bi bi-three-dots"></i></button><div class="ff-menu" id="post-menu-{{ post.idPost }}"><a href="{{ path('app_frontoffice_post_edit', {id: post.idPost}) }}" class="ff-menu-action"><i class="bi bi-pencil"></i> Modifier le post</a><form method="post" action="{{ path('app_frontoffice_post_delete', {id: post.idPost}) }}" class="js-ff-delete" data-delete-kind="post" data-delete-label="ce post"><input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.idPost) }}"><button type="submit" class="ff-menu-action is-danger"><i class="bi bi-trash"></i> Supprimer le post</button></form></div></div>{% endif %}</div>
<div class="ff-post-body"><h3 class="ff-post-title">{{ post.title }}</h3><p class="ff-post-text">{{ post.content|nl2br }}</p></div>
{% set rawPostImage = post.imageUrl|default('') %}
{% set canRenderPostImage = rawPostImage starts with 'http' or rawPostImage starts with '/uploads/' or rawPostImage starts with 'uploads/' %}
{% if canRenderPostImage %}{% set postImageSrc = rawPostImage starts with 'http' ? rawPostImage : asset(rawPostImage starts with '/' ? rawPostImage|slice(1) : rawPostImage) %}<img src="{{ postImageSrc }}" alt="Image du post" class="ff-post-image">{% endif %}
<div class="ff-stats"><div class="ff-stats-left"><span data-reaction-count="like"><i class="bi bi-hand-thumbs-up-fill" style="color:#60a5fa;"></i> {{ likes }}</span><span data-reaction-count="love"><i class="bi bi-heart-fill" style="color:#f87171;"></i> {{ loves }}</span><span data-reaction-count="dislike"><i class="bi bi-hand-thumbs-down-fill" style="color:#fbbf24;"></i> {{ dislikes }}</span></div><div class="ff-stats-right"><span data-comment-count>{{ post.comments|length }} commentaire{{ post.comments|length > 1 ? 's' : '' }}</span></div></div>
<div class="ff-divider"></div>
<div class="ff-actions"><div class="ff-menu-wrap"><button type="button" class="ff-action-btn" data-menu-toggle="reaction-menu-{{ post.idPost }}"><i class="bi bi-emoji-smile"></i> Reagir</button><div class="ff-menu ff-reaction-menu" id="reaction-menu-{{ post.idPost }}"><div class="ff-reaction-options"><form method="post" action="{{ path('app_frontoffice_reaction_toggle', {postId: post.idPost, type: 'LIKE'}) }}" class="js-ff-reaction" data-post-id="{{ post.idPost }}"><button type="submit" class="ff-reaction-pill like"><i class="bi bi-hand-thumbs-up-fill"></i></button></form><form method="post" action="{{ path('app_frontoffice_reaction_toggle', {postId: post.idPost, type: 'LOVE'}) }}" class="js-ff-reaction" data-post-id="{{ post.idPost }}"><button type="submit" class="ff-reaction-pill love"><i class="bi bi-heart-fill"></i></button></form><form method="post" action="{{ path('app_frontoffice_reaction_toggle', {postId: post.idPost, type: 'DISLIKE'}) }}" class="js-ff-reaction" data-post-id="{{ post.idPost }}"><button type="submit" class="ff-reaction-pill dislike"><i class="bi bi-hand-thumbs-down-fill"></i></button></form></div></div></div><button type="button" class="ff-action-btn" data-comment-focus="{{ post.idPost }}"><i class="bi bi-chat-left-text"></i> Commenter</button></div>
<div class="ff-comments"><div class="ff-comments-list" data-comments-list>{% for comment in post.comments %}{% set cUser = comment.user %}{% set cRole = cUser ? cUser.role|upper : 'UNKNOWN' %}{% set cInitials = cUser ? (cUser.firstName|default('?'))|first ~ (cUser.lastName|default('?'))|first : '??' %}{% set isAdminComment = cRole == 'ADMIN' or cRole == 'ROLE_ADMIN' %}{% set isOwnComment = currentUser and cUser and currentUser.id == cUser.id %}<div class="ff-comment-item"><div class="ff-comment-avatar">{{ cInitials|upper }}</div><div class="ff-comment-main"><div class="ff-comment-top"><div class="ff-comment-name-row"><span class="ff-comment-name">{{ cUser ? cUser.firstName ~ ' ' ~ cUser.lastName : 'Utilisateur inconnu' }}</span>{% if isAdminComment %}<span class="ff-badge-admin"><i class="bi bi-shield-fill-check"></i> Admin</span>{% else %}<span class="ff-badge-role">{{ cRole|replace({'ROLE_': ''}) }}</span>{% endif %}{% if comment.isEdited %}<span class="ff-badge-soft" data-edited-badge="true">Modifie</span>{% endif %}</div><div class="ff-comment-top-right"><span class="ff-comment-date" data-comment-date>{{ (comment.isEdited ? comment.updated_at : comment.createdAt)|date('d/m/Y H:i') }}</span>{% if isOwnComment %}<div class="ff-menu-wrap"><button type="button" class="ff-icon-btn" data-menu-toggle="comment-menu-{{ comment.idComment }}"><i class="bi bi-three-dots"></i></button><div class="ff-menu" id="comment-menu-{{ comment.idComment }}"><button type="button" class="ff-menu-action" data-edit-toggle="comment-edit-{{ comment.idComment }}"><i class="bi bi-pencil"></i> Modifier le commentaire</button><form method="post" action="{{ path('app_frontoffice_comment_delete', {id: comment.idComment}) }}" class="js-ff-delete" data-delete-kind="comment" data-delete-label="ce commentaire"><input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.idComment) }}"><button type="submit" class="ff-menu-action is-danger"><i class="bi bi-trash"></i> Supprimer le commentaire</button></form></div></div>{% endif %}</div></div><div class="ff-comment-bubble"><p class="ff-comment-text">{{ comment.content|nl2br }}</p></div>{% if isOwnComment %}<form method="post" action="{{ path('app_frontoffice_comment_edit', {id: comment.idComment}) }}" id="comment-edit-{{ comment.idComment }}" class="ff-edit js-ff-comment-edit"><textarea name="comment_content" rows="2">{{ comment.content }}</textarea><button type="submit">Enregistrer</button></form>{% endif %}</div></div>{% else %}<div class="ff-empty" data-empty-comments>Aucun commentaire pour ce post.</div>{% endfor %}</div>{% if currentUser %}<div class="ff-comment-composer"><div class="ff-comment-avatar">{{ userInitials|upper }}</div>{{ form_start(commentForms[post.idPost], {'attr': {'class': 'ff-comment-form js-ff-comment-form', 'data-post-id': post.idPost}}) }}{{ form_widget(commentForms[post.idPost].content, {'attr': {'placeholder': 'Ajouter un commentaire...', 'rows': 1, 'id': 'ff-comment-input-' ~ post.idPost, 'data-comment-input': post.idPost}}) }}<button type="submit" class="ff-comment-submit is-hidden" data-comment-submit>Publier</button>{{ form_end(commentForms[post.idPost]) }}</div>{% endif %}</div>
</article>
{% else %}
<section class="ff-empty-feed" data-posts-empty><i class="bi bi-megaphone" style="font-size:36px;display:block;margin-bottom:10px;"></i>{{ searchTerm ? 'Aucun post ne correspond a votre recherche.' : 'Aucun post dans votre feed pour le moment.' }}</section>
{% endfor %}
</div></div>

<div class="ff-modal-backdrop" id="ff-delete-modal" aria-hidden="true"><div class="ff-modal" role="dialog" aria-modal="true"><div class="ff-modal-head"><div class="ff-modal-icon"><i class="bi bi-trash3"></i></div><h3 class="ff-modal-title">Confirmer la suppression</h3></div><div class="ff-modal-body" id="ff-delete-text">Cette action supprimera l'element selectionne.</div><div class="ff-modal-actions"><button type="button" class="ff-modal-btn ff-modal-btn-secondary" id="ff-delete-cancel">Annuler</button><button type="button" class="ff-modal-btn ff-modal-btn-danger" id="ff-delete-confirm">Supprimer</button></div></div></div>

<script>
const ffModal=document.getElementById('ff-delete-modal'),ffModalText=document.getElementById('ff-delete-text'),ffConfirm=document.getElementById('ff-delete-confirm');
let ffPendingDelete=null;
function ffCloseMenus(){
    document.querySelectorAll('.ff-menu.is-open').forEach(m=>m.classList.remove('is-open'));}
function ffFlash(msg,type){
    const c=document.querySelector('.ff-shell');
if(!c)return;
const n=document.createElement('div');
n.className='ff-flash '+(type==='danger'?'ff-flash-danger':'ff-flash-success');
n.textContent=msg;c.prepend(n);setTimeout(()=>{n.classList.add('is-hiding');setTimeout(()=>n.remove(),320);},4200);}
function ffAutoHide(){
    document.querySelectorAll('.ff-flash').forEach((f,i)=>setTimeout(()=>{f.classList.add('is-hiding');
setTimeout(()=>f.remove(),320);},3600+(i*180)));}
function ffCommentCount(post,count){
    const n=post.querySelector('[data-comment-count]');
    if(n)n.textContent=count+' commentaire'+(count>1?'s':'');}
function ffEnsureEmpty(post){
    const list=post.querySelector('[data-comments-list]');
    if(!list)return;const has=list.querySelector('.ff-comment-item'),empty=list.querySelector('[data-empty-comments]');
    if(has){if(empty)empty.remove();
    return;}if(!empty){const d=document.createElement('div');
    d.className='ff-empty';d.setAttribute('data-empty-comments','');
    d.textContent='Aucun commentaire pour ce post.';
    list.appendChild(d);}}
function ffEnsurePosts(){
    const c=document.querySelector('.ff-shell');
    if(!c)return;
    const posts=c.querySelectorAll('.ff-post[data-post-id]');
    let empty=c.querySelector('[data-posts-empty]');
    if(posts.length>0){if(empty)empty.remove();
    return;}if(!empty){empty=document.createElement('section');
    empty.className='ff-empty-feed';empty.setAttribute('data-posts-empty','');
    empty.textContent='Aucun post dans votre feed pour le moment.';c.appendChild(empty);}}
function ffOpenDelete(form){
    ffPendingDelete=form;ffModalText.textContent='Cette action supprimera definitivement '+(form.getAttribute('data-delete-label')||'cet element')+'.';
    ffModal.classList.add('is-open');ffModal.setAttribute('aria-hidden','false');}
function ffCloseDelete(){
    ffPendingDelete=null;ffModal.classList.remove('is-open');
    ffModal.setAttribute('aria-hidden','true');}
async function ffSubmitDelete(form){
    const r=await fetch(form.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:new FormData(form)}),d=await r.json();if(!r.ok||!d.success){ffFlash(d.message||'Suppression impossible.','danger');return;}const kind=form.getAttribute('data-delete-kind');
    if(kind==='post'){const p=form.closest('.ff-post');
    if(p)p.remove();ffEnsurePosts();}
    if(kind==='comment'){const p=form.closest('.ff-post'),i=form.closest('.ff-comment-item');
    if(i)i.remove();if(p){const count=p.querySelectorAll('.ff-comment-item').length;ffCommentCount(p,count);p.dataset.comments=String(count);
    ffEnsureEmpty(p);}}ffFlash(d.message||'Element supprime.','success');}
function ffEscape(v){
    return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function ffRole(v){return String(v||'').replace('ROLE_','');}
function ffCreateComment(c){
    const n=document.createElement('div');n.className='ff-comment-item';n.innerHTML=`<div class="ff-comment-avatar">${ffEscape(c.authorInitials)}</div><div class="ff-comment-main"><div class="ff-comment-top"><div class="ff-comment-name-row"><span class="ff-comment-name">${ffEscape(c.authorName)}</span>${c.isAdmin?'<span class="ff-badge-admin"><i class="bi bi-shield-fill-check"></i> Admin</span>':'<span class="ff-badge-role">'+ffEscape(ffRole(c.roleLabel))+'</span>'}</div><div class="ff-comment-top-right"><span class="ff-comment-date" data-comment-date>${ffEscape(c.createdAt)}</span><div class="ff-menu-wrap"><button type="button" class="ff-icon-btn" data-menu-toggle="comment-menu-${c.id}"><i class="bi bi-three-dots"></i></button><div class="ff-menu" id="comment-menu-${c.id}"><button type="button" class="ff-menu-action" data-edit-toggle="comment-edit-${c.id}"><i class="bi bi-pencil"></i> Modifier le commentaire</button><form method="post" action="${ffEscape(c.deleteUrl)}" class="js-ff-delete" data-delete-kind="comment" data-delete-label="ce commentaire"><input type="hidden" name="_token" value="${ffEscape(c.deleteToken)}"><button type="submit" class="ff-menu-action is-danger"><i class="bi bi-trash"></i> Supprimer le commentaire</button></form></div></div></div></div><div class="ff-comment-bubble"><p class="ff-comment-text">${ffEscape(c.content).replace(/\n/g,'<br>')}</p></div><form method="post" action="${ffEscape(c.editUrl)}" id="comment-edit-${c.id}" class="ff-edit js-ff-comment-edit"><textarea name="comment_content" rows="2">${ffEscape(c.content)}</textarea><button type="submit">Enregistrer</button></form></div>`;return n;}
function ffSyncSubmit(form){
    const t=form.querySelector('textarea'),b=form.querySelector('[data-comment-submit]');if(!t||!b)return;const ok=t.value.trim().length>0;b.classList.toggle('is-hidden',!ok);b.disabled=!ok;}
function ffFocus(postId){
    const t=document.querySelector('[data-comment-input="'+postId+'"]');if(!t)return;const c=t.closest('.ff-comment-composer');if(c)c.classList.add('is-targeted');t.classList.add('is-targeted-field');t.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>{t.focus();if(typeof t.setSelectionRange==='function'){const e=t.value.length;t.setSelectionRange(e,e);}},140);}
document.addEventListener('click',function(e){const toggle=e.target.closest('[data-menu-toggle]'),edit=e.target.closest('[data-edit-toggle]'),focus=e.target.closest('[data-comment-focus]');
if(e.target===ffModal||e.target.closest('#ff-delete-cancel')){ffCloseDelete();return;}if(focus){e.preventDefault();ffFocus(focus.getAttribute('data-comment-focus'));return;}if(toggle){const id=toggle.getAttribute('data-menu-toggle'),m=document.getElementById(id),open=m&&m.classList.contains('is-open');ffCloseMenus();if(m&&!open)m.classList.add('is-open');return;}if(edit){const f=document.getElementById(edit.getAttribute('data-edit-toggle'));if(f)f.classList.toggle('is-open');ffCloseMenus();return;}if(!e.target.closest('.ff-menu-wrap'))ffCloseMenus();});
ffConfirm.addEventListener('click',async()=>{if(!ffPendingDelete)return;const f=ffPendingDelete;ffCloseDelete();await ffSubmitDelete(f);});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&ffModal.classList.contains('is-open'))ffCloseDelete();});
document.querySelectorAll('.js-ff-reaction').forEach(form=>form.addEventListener('submit',async function(e){e.preventDefault();const id=form.getAttribute('data-post-id'),post=document.querySelector('[data-post-id="'+id+'"]');if(!post)return;const r=await fetch(form.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:new FormData(form)});if(!r.ok){ffFlash('Impossible de mettre a jour la reaction.','danger');return;}const d=await r.json();if(!d.success){ffFlash(d.message||'Impossible de mettre a jour la reaction.','danger');return;}post.querySelector('[data-reaction-count="like"]').innerHTML='<i class="bi bi-hand-thumbs-up-fill" style="color:#60a5fa;"></i> '+d.counts.like;post.querySelector('[data-reaction-count="love"]').innerHTML='<i class="bi bi-heart-fill" style="color:#f87171;"></i> '+d.counts.love;post.querySelector('[data-reaction-count="dislike"]').innerHTML='<i class="bi bi-hand-thumbs-down-fill" style="color:#fbbf24;"></i> '+d.counts.dislike;post.dataset.reactions=String((d.counts.like||0)+(d.counts.love||0)+(d.counts.dislike||0));ffCloseMenus();}));
document.querySelectorAll('.js-ff-comment-form').forEach(form=>{ffSyncSubmit(form);const t=form.querySelector('textarea');if(t){t.addEventListener('input',()=>ffSyncSubmit(form));t.addEventListener('focus',()=>{const c=t.closest('.ff-comment-composer');if(c)c.classList.add('is-targeted');t.classList.add('is-targeted-field');});t.addEventListener('blur',()=>{const c=t.closest('.ff-comment-composer');if(c)c.classList.remove('is-targeted');t.classList.remove('is-targeted-field');});}});
document.addEventListener('submit',async function(e){const del=e.target.closest('.js-ff-delete');if(del){e.preventDefault();ffOpenDelete(del);ffCloseMenus();return;}const add=e.target.closest('.js-ff-comment-form');if(add){e.preventDefault();const id=add.getAttribute('data-post-id'),post=document.querySelector('[data-post-id="'+id+'"]');if(!post)return;const r=await fetch(add.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:new FormData(add)}),d=await r.json();if(!r.ok||!d.success){ffFlash(d.message||"Impossible d'ajouter le commentaire.",'danger');return;}const list=post.querySelector('[data-comments-list]'),empty=post.querySelector('[data-empty-comments]');if(empty)empty.remove();list.appendChild(ffCreateComment(d.comment));ffCommentCount(post,d.commentCount);post.dataset.comments=String(d.commentCount);add.reset();ffSyncSubmit(add);return;}const edit=e.target.closest('.js-ff-comment-edit');if(edit){e.preventDefault();const r=await fetch(edit.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:new FormData(edit)}),d=await r.json();if(!r.ok||!d.success){ffFlash(d.message||'Impossible de modifier le commentaire.','danger');return;}const main=edit.closest('.ff-comment-main');if(!main)return;const text=main.querySelector('.ff-comment-text'),date=main.querySelector('[data-comment-date]'),badges=main.querySelector('.ff-comment-name-row');let edited=badges?badges.querySelector('[data-edited-badge]'):null;if(text)text.innerHTML=ffEscape(d.comment.content).replace(/\n/g,'<br>');if(date)date.textContent=d.comment.updatedAt;if(badges&&!edited){edited=document.createElement('span');edited.className='ff-badge-soft';edited.setAttribute('data-edited-badge','true');edited.textContent='Modifie';badges.appendChild(edited);}edit.classList.remove('is-open');ffFlash(d.message||'Commentaire modifie.','success');}});
ffAutoHide();
</script>
{% endblock %}
