{% extends 'user/frontoffice/index.html.twig' %}

{% block title %}Accueil - HireHive{% endblock %}

{% block frontoffice_content %}
<section class="learning-hero">
  <div class="floating-card card-1">
    <img src="/hero/hero1.jpg" alt="Equipe en reunion de recrutement">
  </div>

  <div class="floating-card card-2 badge-card">
    <span class="badge-medal" aria-hidden="true">
      <svg viewBox="0 0 48 60" xmlns="http://www.w3.org/2000/svg" fill="none">
        <circle cx="24" cy="18" r="16" fill="#fcd34d" stroke="#f59e0b" stroke-width="3"/>
        <path d="M14 32 10 56l14-8 14 8-4-24" fill="#f97316"/>
        <circle cx="24" cy="18" r="8" fill="#fde68a" stroke="#d97706" stroke-width="3"/>
      </svg>
    </span>
    <img src="/hero/hero2.jpg" alt="Responsable RH bras croises en bureau">
  </div>

  <div class="floating-card card-3">
    <img src="/hero/hero3.jpg" alt="Chef de projet animant un atelier">
  </div>

  <div class="floating-card card-4">
    <img src="/hero/hero4.jpg" alt="Consultante RH en hijab">
  </div>

  <div class="floating-card card-5">
    <img src="/hero/hero5.jpg" alt="Equipe produit en coworking">
  </div>

  <div class="floating-card card-6">
    <img src="/hero/hero6.jpg" alt="Manager travaillant sur un laptop">
  </div>

  <div class="floating-card card-7">
    <img src="/hero/hero7.jpg" alt="Developpeurs au bureau">
  </div>

  <div class="floating-card card-8">
    <img src="/hero/hero8.jpg" alt="Collaboratrice concentree sur son laptop">
  </div>

  <div class="review-cluster">
    <div class="hat-doodle" aria-hidden="true">
      <svg viewBox="0 0 160 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#5b21b6" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 52 80 22l62 30-62 30-62-30Z"/>
        <path d="M80 82c0 10-24 20-40 10"/>
        <path d="M142 52v26"/>
      </svg>
    </div>
    <div class="review-bubble">
      <span class="star-pill" aria-hidden="true">★</span>
      <div>
        <p class="review-title">1M+ professionnels font confiance</p>
        <p class="review-text">aux recruteurs et managers sur HireHive</p>
      </div>
    </div>
  </div>

  <div class="hero-core">
    <h1 class="hero-title">HireHive</h1>
    <p class="hero-subtitle">One Platform. Endless Talent.</p>
    <div class="hero-actions">
      <a class="btn-cta" href="{{ path('app_frontoffice_offers') }}">Voir les opportunites <span class="arrow">&#8594;</span></a>
    </div>
  </div>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@600;700;800&display=swap');

.learning-hero {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border-radius: 18px;
  padding: 80px 0 120px;
  min-height: 640px;
  isolation: isolate;
}

.hero-core {
  position: relative;
  max-width: 980px;
  margin: 0 auto;
  text-align: center;
  padding: 0 32px;
  font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
  transform: translateY(-70px);
}

.hero-title {
  margin: 0 0 16px;
  font-size: clamp(36px, 5.6vw, 68px);
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -0.6px;
  color: #6b21a8;
}

.hero-subtitle {
  margin: 0 auto;
  max-width: 780px;
  font-size: 18px;
  line-height: 1.6;
  color: #606775;
}

.hero-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 32px;
  transform: translate(-32px, -10px);
}

.btn-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 15px 26px;
  border-radius: 14px;
  background: #f7c948;
  color: #1f2633;
  font-weight: 800;
  font-size: 17px;
  text-decoration: none;
  box-shadow: 0 18px 38px rgba(247, 201, 72, 0.35);
  border: 1px solid #f5b930;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 26px 50px rgba(247, 201, 72, 0.45);
}

.arrow { font-size: 18px; }

.floating-card {
  position: absolute;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 22px 45px rgba(15, 23, 42, 0.16);
  background: #f8fafc;
}

.floating-card img { width: 100%; height: 100%; object-fit: cover; display: block; }

.card-1 { width: 190px; height: 260px; left: -60px; top: 120px; }
.card-2 { width: 210px; height: 340px; left: 40px; top: 90px; }
.card-3 { width: 180px; height: 180px; left: -50px; bottom: 70px; }
.card-4 { width: 200px; height: 320px; right: 18px; top: 70px; }
.card-5 { width: 150px; height: 190px; right: 80px; top: 240px; }
.card-6 { width: 190px; height: 230px; right: 80px; bottom: 70px; }
.card-7 { width: 140px; height: 190px; right: -10px; bottom: 50px; }
.card-8 { width: 140px; height: 180px; right: 320px; bottom: 30px; }

.badge-card { position: relative; }
.badge-medal {
  position: absolute;
  top: -22px;
  left: -18px;
  width: 72px;
  height: 90px;
  z-index: 2;
}

.review-cluster {
  position: absolute;
  right: 240px;
  top: 42px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 3;
}

.hat-doodle { width: 110px; height: 90px; opacity: 0.9; }

.review-bubble {
  display: inline-flex;
  align-items: flex-start;
  gap: 12px;
  background: #ffffff;
  border-radius: 14px;
  padding: 14px 16px;
  box-shadow: 0 22px 48px rgba(0, 0, 0, 0.12);
  min-width: 260px;
}

.star-pill {
  background: #ff7f18;
  color: #ffffff;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-size: 22px;
  box-shadow: 0 12px 32px rgba(255, 127, 24, 0.36);
}

.review-title { margin: 0; font-weight: 700; color: #1f2633; font-size: 15px; }
.review-text { margin: 4px 0 0; color: #606775; font-size: 14px; line-height: 1.4; }

@media (max-width: 1200px) {
  .card-1 { left: -28px; }
  .card-2 { left: 40px; }
  .card-3 { left: -40px; }
  .card-4 { right: -6px; }
  .card-5 { right: 120px; }
  .card-6 { right: 30px; }
  .card-8 { right: 250px; }
  .review-cluster { right: 120px; }
}

@media (max-width: 1024px) {
  .floating-card { opacity: 0.9; }
  .card-1, .card-3 { display: none; }
  .card-2 { left: 12px; }
  .card-4 { right: 12px; }
  .card-5 { right: 60px; }
  .card-6 { right: 10px; }
  .card-7 { right: -18px; }
  .card-8 { right: 180px; }
  .review-cluster { top: 28px; right: 40px; }
}

@media (max-width: 780px) {
  .learning-hero { padding: 64px 0 80px; }
  .floating-card { display: none; }
  .review-cluster { display: none; }
  .hero-title { font-size: clamp(32px, 9vw, 46px); }
  .hero-subtitle { font-size: 16px; }
  .btn-cta { width: 100%; justify-content: center; }
}
</style>
{% endblock %}
