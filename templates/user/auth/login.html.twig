<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HireHive | Connexion</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --accent: #7c3aed;
      --accent-2: #5b21b6;
      --text: #0f172a;
      --muted: #475569;
      --bg: #f6f4fb;
      --card: #ffffff;
      --border: #e6e0f7;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background: var(--bg);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 16px;
      color: var(--text);
    }
    .layout {
      width: 100%;
      max-width: 980px;
      min-height: 520px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08);
    }
    .hero {
      background: #f1eafe;
      color: var(--text);
      display: flex;
      align-items: center;
      padding: 32px;
    }
    .hero-content { max-width: 440px; }
    .pill {
      display: inline-block;
      padding: 6px 10px;
      background: #ede9fe;
      border: 1px solid #e6e0f7;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.3px;
      margin-bottom: 10px;
    }
    .hero h1 {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      color: var(--accent-2);
    }
    .hero h2 {
      margin: 6px 0 8px;
      font-size: 20px;
      font-weight: 700;
      line-height: 1.3;
    }
    .hero p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--muted); }
    .panel {
      background: var(--card);
      padding: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      width: 100%;
      max-width: 400px;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px;
      background: var(--card);
    }
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 10px;
    }
    .connect { color: var(--muted); }
    .google-icon {
      background: #eef2ff;
      border: 1px solid #cdd4ff;
      color: #1d4ed8;
      border-radius: 6px;
      padding: 2px 6px;
      font-weight: 700;
      font-size: 12px;
    }
    .logo-row { display: flex; justify-content: center; margin-bottom: 6px; }
    .logo-row img { height: 48px; }
    .title {
      margin: 6px 0 2px;
      font-size: 22px;
      font-weight: 800;
      color: var(--text);
      text-align: center;
    }
    .subtitle {
      margin: 0 0 12px;
      color: var(--muted);
      text-align: center;
      font-size: 14px;
    }
    form { display: flex; flex-direction: column; gap: 10px; }
    label {
      font-size: 13px;
      color: var(--text);
      font-weight: 700;
    }
    input[type=email], input[type=password] {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #f8faf9;
      font-size: 14px;
      color: var(--text);
    }
    input:focus {
      outline: 2px solid rgba(31,122,90,0.2);
      outline-offset: 1px;
    }
    .forgot {
      text-align: right;
      font-size: 13px;
      color: var(--accent-2);
      text-decoration: none;
      margin-top: -4px;
    }
    .btn {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 11px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      background: var(--card);
      color: var(--text);
    }
    .btn-primary {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
      margin-top: 6px;
    }
    .btn-outline { background: var(--card); color: var(--accent-2); border-color: var(--border); margin-bottom: 8px; }
    .btn-outline:hover { background: #f3f0fe; }
    .alert {
      padding: 10px 12px;
      border-radius: 8px;
      margin-bottom: 12px;
      font-size: 14px;
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #991b1b;
    }
    .helper {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      margin-top: 6px;
    }
    @media (max-width: 900px) {
      body { padding: 10px; }
      .layout { grid-template-columns: 1fr; }
      .hero { min-height: 200px; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <section class="hero">
      <div class="hero-content">
        <div class="pill">HireHive</div>
        <h1>Connexion</h1>
        <h2>Accédez à votre espace</h2>
        <p>Interface simple pour gérer vos candidatures et vos offres.</p>
      </div>
    </section>

    <section class="panel">
      <div class="card">
        <div class="card-top">
          <span>FR</span>
          <span class="connect">Se connecter avec : <span class="google-icon">G</span></span>
        </div>

        <div class="logo-row">
          <img src="/assets/logo.png" alt="HireHive">
        </div>

        <h1 class="title">Bienvenue</h1>
        <p class="subtitle">Connectez-vous à votre compte</p>

        {% if error %}
          <div class="alert">Identifiants invalides.</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
          <label for="username">Email professionnel</label>
          <input id="username" name="_username" type="email" value="{{ last_username }}" required autofocus autocomplete="email" placeholder="you@example.com">

          <label for="password">Mot de passe</label>
          <input id="password" name="_password" type="password" required autocomplete="current-password" placeholder="••••••••">

          <a class="forgot" href="#">Mot de passe oublié ?</a>

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

          <button class="btn btn-primary" type="submit">Connexion</button>
          <button class="btn btn-outline" type="button">Authentifier par visage</button>
          <a class="btn btn-outline" href="{{ path('app_register') }}" role="button" style="text-decoration:none;text-align:center;display:block;">S'inscrire</a>
        </form>

        <div class="helper">En cas de souci de connexion, contactez l'administrateur.</div>
      </div>
    </section>
  </div>
</body>
</html>
