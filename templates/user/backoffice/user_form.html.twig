{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ title }} - Backoffice{% endblock %}

{% block backoffice_content %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
<style>
.user-form-shell { padding:16px; }
.user-form-card {
  max-width: 840px;
  margin: 0 auto;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px;
}
.user-form-header { margin-bottom: 10px; }
.user-form-title { margin: 0; color: var(--text); font-size: 20px; font-weight: 800; }
.small-note { color: var(--muted); font-size: 13px; margin: 4px 0 0 0; }
.form-grid-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.user-form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); }
.form-control, .form-select { background: #0f172a; border: 1px solid var(--border); color: var(--text); }
.form-control:focus, .form-select:focus { background: #0f172a; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(124,58,237,0.18); color: var(--text); }
.form-label { color: var(--text); font-weight: 700; }
.form-check-input { background: #0f172a; border-color: var(--border); }
.form-check-input:checked { background-color: var(--accent); border-color: var(--accent); }
.form-text { color: var(--muted); font-size: 12px; }
</style>
<div class="user-form-shell">
    <div class="user-form-card">
        <div class="user-form-header">
            <h2 class="user-form-title">{{ title }}</h2>
            <p class="small-note">Champs marqués * obligatoires. Remplis uniquement ce qui est utile.</p>
        </div>
        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger">
                {{ form_errors(form) }}
            </div>
        {% endif %}
        {{ form_start(form) }}
            <div class="form-grid-two">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
                {{ form_row(form.email) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.role) }}
                {{ form_row(form.status) }}
                {{ form_row(form.isActive) }}
            </div>
            <div class="user-form-actions">
                <a class="btn btn-ghost" href="{{ path('app_backoffice_users') }}">Annuler</a>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
