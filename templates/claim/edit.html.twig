{% extends 'base.html.twig' %}

{% block title %}Éditer la réclamation – HireHive{% endblock %}

{% block content %}
<div class="form-page">

    <div class="form-header">
        <a href="{{ path('app_claim_show', {id: claim.id}) }}" class="back-link">← Retour à la réclamation</a>
        <h1 class="form-h1">Éditer la réclamation</h1>
        <p class="form-sub">
            Modifiez les détails de votre réclamation ci-dessous.
        </p>
    </div>

    {{ form_start(form) }}

        {# ── Type ── #}
        <div class="field-group">
            {{ form_label(form.type, 'Type de réclamation') }}
            {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
            {% if form.type.vars.errors|length > 0 %}
                <div class="field-errors">
                    {% for error in form.type.vars.errors %}
                        <span class="error-msg">! {{ error.message }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ── Priorité ── #}
        <div class="field-group">
            {{ form_label(form.priority, 'Priorité') }}
            {{ form_widget(form.priority, {'attr': {'class': 'form-control'}}) }}
            {% if form.priority.vars.errors|length > 0 %}
                <div class="field-errors">
                    {% for error in form.priority.vars.errors %}
                        <span class="error-msg">! {{ error.message }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ── Title ── #}
        <div class="field-group">
            {{ form_label(form.title, 'Titre') }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
            {% if form.title.vars.errors|length > 0 %}
                <div class="field-errors">
                    {% for error in form.title.vars.errors %}
                        <span class="error-msg">! {{ error.message }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ── Description ── #}
        <div class="field-group">
            {{ form_label(form.description, 'Description') }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            {% if form.description.vars.errors|length > 0 %}
                <div class="field-errors">
                    {% for error in form.description.vars.errors %}
                        <span class="error-msg">! {{ error.message }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="form-footer">
            <button type="submit" class="btn-submit">Enregistrer</button>
            <a href="{{ path('app_claim_show', {id: claim.id}) }}" class="btn-cancel">Annuler</a>
        </div>



    {{ form_end(form) }}

</div>

<style>
.form-page { max-width: 640px; margin: 0 auto; }
.form-header { margin-bottom: 28px; }
.back-link { color: #7c3aed; font-size: 13px; text-decoration: none; font-weight: 600; }
.back-link:hover { text-decoration: underline; }
.form-h1 { margin: 10px 0 6px; font-size: 24px; font-weight: 800; color: #111827; }
.form-sub { color: #6b7280; font-size: 14px; margin: 0; }
.field-group { margin-bottom: 20px; }
.field-group label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 6px; color: #374151; }
.form-control { width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; font-family: inherit; background: #fafafa; color: #111827; transition: border-color .2s; }
.form-control:focus { outline: none; border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,.12); background: #fff; }
.field-errors { margin-top: 6px; }
.error-msg { display: block; color: #b91c1c; font-size: 13px; font-weight: 600; background: #fee2e2; padding: 5px 10px; border-radius: 6px; margin-top: 4px; border: 1px solid #fecaca; }
.form-footer { display: flex; gap: 12px; align-items: center; margin-top: 28px; }
.btn-submit { background: #7c3aed; color: #fff; padding: 11px 28px; border: none; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; }
.btn-submit:hover { background: #5b21b6; }
.btn-cancel { color: #6b7280; font-size: 14px; text-decoration: none; }
.btn-cancel:hover { color: #111827; }
</style>
{% endblock %}
