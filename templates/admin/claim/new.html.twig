{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer une Réclamation – Backoffice{% endblock %}

{% block backoffice_content %}
<div class="adm-header" style="margin-bottom:20px;">
    <a href="{{ path('app_admin_claim_index') }}" style="color:var(--accent); font-size:13px; font-weight:700; text-decoration:none;">← Retour à la liste</a>
    <h1 class="section-title" style="margin-top:8px;">Ajouter une Réclamation</h1>
    <p style="color:var(--muted); font-size:14px; margin:4px 0 0;">Créer et lier manuellement une réclamation à un utilisateur existant.</p>
</div>

<div class="adm-form-card" style="background:#0f172a; border:1px solid var(--border); border-radius:12px; padding:24px; max-width:680px;">
    <form method="POST" novalidate>
        {% if errors is defined and errors|length > 0 %}
            <div style="background:#450a0a; border:1px solid #7f1d1d; border-radius:8px; padding:12px; margin-bottom:20px;">
                <h3 style="color:#fca5a5; margin-top:0; margin-bottom:8px; font-size:14px;">Il y a des erreurs dans votre formulaire :</h3>
                <ul style="color:#fca5a5; font-size:13px; margin:0; padding-left:20px;">
                    {% for err in errors %}
                        <li>{{ err }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        <div class="field-group" style="margin-bottom:20px;">
            <label for="user_id" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Utilisateur</label>
            <select id="user_id" name="user_id" class="adm-input" style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit;">
                <option value="">-- Sélectionnez un utilisateur --</option>
                {% for user in users %}
                    <option value="{{ user.id }}">#{{ user.id }} - {{ user.email }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="field-group" style="margin-bottom:20px;">
            <label for="type" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Type de Réclamation</label>
            <select id="type" name="type" class="adm-input" style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit;">
                <option value="">-- Sélectionnez un type --</option>
                <option value="Problème Technique">Problème Technique</option>
                <option value="Problème de Facturation">Problème de Facturation</option>
                <option value="Qualité de Service">Qualité de Service</option>
                <option value="Autre">Autre</option>
            </select>
        </div>

        <div class="field-group" style="margin-bottom:20px;">
            <label for="priority" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Priorité</label>
            <select id="priority" name="priority" class="adm-input" style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit;">
                <option value="LOW">Basse</option>
                <option value="MEDIUM">Moyenne</option>
                <option value="URGENT">Urgente</option>
            </select>
        </div>

        <div class="field-group" style="margin-bottom:20px;">
            <label for="title" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Titre</label>
            <input type="text" id="title" name="title" class="adm-input" placeholder="Titre de la réclamation" style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit;">
        </div>

        <div class="field-group" style="margin-bottom:20px;">
            <label for="description" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Description</label>
            <textarea id="description" name="description" class="adm-input" rows="5" placeholder="Détails du problème..." style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit; resize:vertical;"></textarea>
        </div>

        <div class="field-group" style="margin-bottom:20px;">
            <label for="initial_response" style="display:block; font-weight:700; font-size:13px; color:var(--muted); margin-bottom:6px;">Réponse initiale (Optionnel)</label>
            <textarea id="initial_response" name="initial_response" class="adm-input" rows="3" placeholder="Ajouter un premier message dans l'historique..." style="width:100%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:#1e293b; color:var(--text); font-family:inherit; resize:vertical;"></textarea>
            <small style="color:var(--muted); font-size:12px;">Sera enregistré dans la table <code>claim_response</code>.</small>
        </div>

        <div style="display:flex; gap:12px; align-items:center; margin-top:24px;">
            <button type="submit" class="adm-btn-primary" style="background:var(--accent); color:#fff; padding:10px 22px; border:none; border-radius:8px; font-weight:700; cursor:pointer;">Ajouter la Réclamation</button>
            <a href="{{ path('app_admin_claim_index') }}" style="color:var(--muted); font-size:13px; text-decoration:none;">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
