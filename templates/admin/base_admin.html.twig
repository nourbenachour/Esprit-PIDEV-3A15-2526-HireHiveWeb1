<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Backoffice - HireHive{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>*</text></svg>">
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        {{ encore_entry_link_tags('styles') }}
        {{ encore_entry_link_tags('app') }}
        <style>
            :root {
                --accent: #7c3aed;
                --accent-2: #a78bfa;
                --text: #e5e7eb;
                --muted: #9ca3af;
                --bg: #0f1117;
                --card: #111827;
                --border: #1f2937;
            }
            * { box-sizing: border-box; }
            body, .hh-body {
                margin: 0;
                padding: 0;
                background: var(--bg);
                color: var(--text);
                font-family: 'Segoe UI', Arial, sans-serif;
            }
            a { color: inherit; text-decoration: none; }
            .dashboard-root { display: flex; flex-direction: column; min-height: 100vh; }
            .dashboard-wrapper { display: flex; flex: 1; min-height: 0; }
            .dashboard-content { flex: 1; overflow-y: auto; padding: 20px; background: var(--bg); }
            /* header */
            .dashboard-header { background: var(--card); border-bottom: 1px solid var(--border); padding: 14px 20px; position: sticky; top: 0; z-index: 40; }
            .dashboard-header-content { display: flex; align-items: center; gap: 12px; min-height: 60px; flex-wrap: wrap; }
            .header-brand { display: flex; align-items: center; gap: 10px; padding-right: 12px; }
            .brand-logo-shell { width: 42px; height: 42px; border-radius: 10px; background: #1a1f2e; border: 1px solid var(--border); display: grid; place-items: center; }
            .header-logo { width: 34px; height: 34px; object-fit: contain; }
            .brand-text-group { display: flex; flex-direction: column; }
            .header-title { margin: 0; font-size: 20px; font-weight: 800; color: var(--text); }
            .brand-subtitle { font-size: 12px; color: var(--muted); letter-spacing: .2px; }
            .header-search { flex: 1; min-width: 220px; max-width: 420px; background: #0f172a; color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 14px; }
            .header-search:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(31,122,90,0.12); }
            .icon-btn { width: 38px; height: 38px; border-radius: 8px; border: 1px solid var(--border); background: #0f172a; color: var(--text); cursor: pointer; font-size: 16px; }
            .icon-btn:hover { background: #111e32; }
            .header-spacer { flex: 1; }
            .user-card { display: flex; align-items: center; gap: 8px; background: #0f172a; border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; min-width: 200px; }
            .user-avatar { width: 38px; height: 38px; border-radius: 50%; background: #1a1f2e; display: grid; place-items: center; color: var(--accent); font-weight: 800; }
            .user-name { font-size: 14px; font-weight: 700; color: var(--text); }
            .user-email { font-size: 12px; color: var(--muted); }
            .btn-logout { background: #0f172a; color: var(--accent); font-size: 13px; font-weight: 700; border: 1px solid var(--accent); border-radius: 8px; padding: 9px 14px; text-decoration: none; }
            .btn-logout:hover { background: #111e32; }
            /* sidebar */
            .dashboard-sidebar { background: #0f172a; border-right: 1px solid var(--border); width: 220px; padding: 16px 14px; overflow-y: auto; flex-shrink: 0; display: flex; flex-direction: column; gap: 10px; }
            .sidebar-logo { padding: 0 0 6px 2px; }
            .logo-text { color: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; }
            .sidebar-section { display: flex; flex-direction: column; gap: 6px; }
            .sidebar-section-label { color: var(--muted); font-size: 11px; font-weight: 700; padding: 4px 2px; letter-spacing: 0.6px; }
            .sidebar-btn { display: block; background: #0f172a; color: var(--text); font-size: 14px; padding: 10px 12px; border-radius: 8px; border: 1px solid transparent; text-decoration: none; }
            .sidebar-btn:hover { border-color: var(--border); background: #111e32; }
            .sidebar-btn-active { background: #1a1f2e; color: var(--accent); border-color: var(--border); }
            /* commons */
            .section-title { color: var(--text); margin: 0 0 8px; font-size: 18px; }
            .list { display:flex; flex-direction:column; gap:8px; }
            .list-item { display:flex; justify-content:space-between; align-items:center; border:1px solid var(--border); border-radius:10px; padding:10px; background:#0f172a; }
            .list-item-title { color:var(--text); font-weight:700; }
            .list-item-meta { color:var(--muted); font-size: 13px; }
            .empty { border: 1px dashed var(--border); color: var(--muted); padding: 10px; border-radius: 10px; background: #f8faf9; text-align: center; }
            @media (max-width: 960px) {
                .dashboard-wrapper { flex-direction: column; }
                .dashboard-sidebar { border-right: none; border-bottom: 1px solid var(--border); width: 100%; flex-direction: row; flex-wrap: wrap; gap: 8px; }
                .sidebar-section { flex-direction: row; flex-wrap: wrap; gap: 8px; }
                .sidebar-section-label { display: none; }
                .sidebar-btn { margin: 0; white-space: nowrap; }
                .dashboard-header-content { flex-direction: column; align-items: stretch; gap: 10px; }
            }
        </style>
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="hh-body">
<div class="dashboard-root">
    {% include 'admin/partials/navbar.html.twig' %}
    <div class="dashboard-wrapper">
        {% include 'admin/partials/sidebar.html.twig' %}
        <main class="dashboard-content">
            {% block backoffice_content %}
                {% include 'admin/home_content.html.twig' %}
            {% endblock %}
        </main>
    </div>
</div>
</body>
</html>
