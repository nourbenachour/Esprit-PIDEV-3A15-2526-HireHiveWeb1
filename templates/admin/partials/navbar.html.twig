<header class="dashboard-header">
    <div class="dashboard-header-content">
        <div class="header-brand">
            <div class="brand-logo-shell">
                <img src="/assets/logo.png" alt="HireHive" class="header-logo">
            </div>
            <div class="brand-text-group">
                <h1 class="header-title">HireHive</h1>
                <span class="brand-subtitle">Backoffice</span>
            </div>
        </div>

        {% set _route = app.request.attributes.get('_route') %}
        <form id="global-search-form" action="{{ path('app_backoffice_users') }}" method="get" style="flex:1; max-width: 420px;">
            <input
                type="text"
                name="q"
                class="header-search"
                placeholder="Rechercher..."
                value="{{ _route starts with 'app_backoffice_users' ? app.request.query.get('q') : '' }}"
            >
            {% if _route starts with 'app_backoffice_users' %}
                <input type="hidden" name="role" value="{{ app.request.query.get('role') }}">
                <input type="hidden" name="status" value="{{ app.request.query.get('status') }}">
                <input type="hidden" name="sort" value="{{ app.request.query.get('sort') }}">
                <input type="hidden" name="direction" value="{{ app.request.query.get('direction') }}">
            {% endif %}
        </form>

        <button class="icon-btn header-bell" type="button" aria-label="Notifications">🔔</button>

        <div class="header-spacer"></div>

        <div class="user-card">
            <div class="user-avatar">
                {{ (app.user.firstName ?? app.user.firstname ?? app.user.userIdentifier ?? 'A')|slice(0,1)|upper }}
            </div>
            <div class="user-info">
                <div class="user-name">{{ app.user.firstName ?? app.user.firstname ?? 'Admin' }}</div>
                <div class="user-email">{{ app.user.userIdentifier ?? '' }}</div>
            </div>
        </div>

        <a href="{{ path('app_logout') }}" class="btn-logout">Déconnexion</a>
    </div>
</header>
