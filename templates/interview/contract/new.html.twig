{% extends 'base.html.twig' %}

{% block title %}Nouveau Contrat{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row g-3">
        <div class="col-lg-3">
            {% include 'interview/_sidebar.html.twig' %}
        </div>
        <div class="col-lg-9">
            <div class="form-shell">
            <h1 class="module-title mb-3">Créer un contrat</h1>
            <p class="text-muted mb-4">Complétez les champs obligatoires (*) pour enregistrer le contrat.</p>

            {{ form_start(form) }}

            <div class="row">
                <div class="col-md-6 mb-3">
                {{ form_label(form.candidateName, 'Nom du candidat *', {'label_attr': {'class': 'field-label'}}) }}
                {{ form_widget(form.candidateName, {'attr': {'class': 'form-control soft-input', 'placeholder': 'Nom complet du candidat'}}) }}
                {{ form_errors(form.candidateName) }}
                </div>

                <div class="col-md-6 mb-3">
                {{ form_label(form.companyName, 'Nom de l\'entreprise *', {'label_attr': {'class': 'field-label'}}) }}
                {{ form_widget(form.companyName, {'attr': {'class': 'form-control soft-input'}}) }}
                {{ form_errors(form.companyName) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                        {{ form_label(form.salary, 'Salaire *', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(form.salary, {'attr': {'class': 'form-control soft-input', 'placeholder': 'Ex: 2500.00'}}) }}
                        {{ form_errors(form.salary) }}
                </div>
                <div class="col-md-6 mb-3">
                        {{ form_label(form.contractType, 'Type de contrat *', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(form.contractType, {'attr': {'class': 'form-control soft-input'}}) }}
                        {{ form_errors(form.contractType) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                        {{ form_label(form.startDate, 'Date de début *', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(form.startDate, {'attr': {'class': 'form-control soft-input'}}) }}
                        {{ form_errors(form.startDate) }}
                </div>
                <div class="col-md-6 mb-3">
                        {{ form_label(form.endDate, 'Date de fin *', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(form.endDate, {'attr': {'class': 'form-control soft-input'}}) }}
                        {{ form_errors(form.endDate) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn soft-btn soft-btn-primary">Créer</button>
                <a href="{{ path('contract_index') }}" class="btn soft-btn soft-btn-light">Annuler</a>
            </div>

            {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<style>
.form-shell { background: #f6f7fb; border: 1px solid #dfe4ef; border-radius: 20px; padding: 24px; }
.module-title { color: #0f1b3e; font-weight: 800; }
.field-label { color: #6d28d9; font-weight: 800; font-size: 1.05rem; }
.soft-input { border-radius: 14px; border: 1px solid #ccd3e3; min-height: 46px; }
.soft-btn { border-radius: 999px; padding: 10px 26px; font-weight: 700; border: 0; }
.soft-btn-primary { background: linear-gradient(135deg, #6c2bd9, #8f4bff); color: #fff; box-shadow: 0 6px 16px rgba(108, 43, 217, 0.35); }
.soft-btn-light { background: #efe9ff; color: #6d28d9; }
</style>
{% endblock %}
