{% extends 'base.html.twig' %}

{% block title %}Contrats{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row g-3">
        <div class="col-lg-3">
            {% include 'interview/_sidebar.html.twig' %}
        </div>
        <div class="col-lg-9">
            <h1 class="module-title mb-3">Contrats</h1>

            <div class="module-card p-3 p-md-4">
                <form method="get" class="filter-panel mb-3">
                    <div class="filter-row filter-row-search">
                        <input type="text" name="search" class="form-control soft-input search-input" placeholder="Recherche.." value="{{ app.request.query.get('search') ?? '' }}">
                    </div>
                    <div class="filter-row filter-row-controls">
                        <span class="filter-label">Du :</span>
                        <input type="date" name="dateFrom" class="form-control soft-input date-input" value="{{ app.request.query.get('dateFrom') ?? '' }}" placeholder="De">
                        <span class="filter-label">Au :</span>
                        <input type="date" name="dateTo" class="form-control soft-input date-input" value="{{ app.request.query.get('dateTo') ?? '' }}" placeholder="A">
                        <button type="submit" class="btn soft-btn soft-btn-primary">Filtrer</button>
                        <a href="{{ path('contract_index') }}" class="btn soft-btn soft-btn-light">Réinitialiser</a>
                    </div>
                </form>

                {% if canManageContracts|default(false) %}
                    <div class="d-flex justify-content-end mb-3">
                        <a href="{{ path('contract_new') }}" class="btn soft-btn soft-btn-primary">Créer un contrat</a>
                    </div>
                {% endif %}

                <div class="table-wrap">
                    <div class="grid-table grid-contracts-cols">
                        <div class="grid-head">Candidat</div>
                        <div class="grid-head">Entreprise</div>
                        <div class="grid-head">Salaire</div>
                        <div class="grid-head">Type</div>
                        <div class="grid-head">Date début</div>
                        <div class="grid-head">Date fin</div>
                        <div class="grid-head">Actions</div>

                    {% if contracts is empty %}
                        <div class="grid-empty">Aucun contrat trouvé</div>
                    {% else %}
                        {% for contract in contracts %}
                            <div class="grid-cell">{{ contract.candidateName }}</div>
                            <div class="grid-cell">{{ contract.companyName }}</div>
                            <div class="grid-cell">{{ contract.salary|number_format(2, ',', ' ') }}</div>
                            <div class="grid-cell">{{ contract.contractType }}</div>
                            <div class="grid-cell">{{ contract.startDate|date('d/m/Y') }}</div>
                            <div class="grid-cell">{{ contract.endDate|date('d/m/Y') }}</div>
                            <div class="grid-cell actions-cell">
                                <a href="{{ path('contract_show', {id: contract.idContrat}) }}" class="action-btn" title="Voir"><i class="bi bi-eye"></i></a>
                                {% if canManageContracts|default(false) %}
                                    <a href="{{ path('contract_edit', {id: contract.idContrat}) }}" class="action-btn" title="Modifier"><i class="bi bi-pencil-square"></i></a>
                                    <form method="post" action="{{ path('contract_delete', {id: contract.idContrat}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contract.idContrat) }}">
                                        <button type="submit" class="action-btn" title="Supprimer"><i class="bi bi-trash"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.module-title { color: #ff6a00; font-weight: 800; letter-spacing: 0.2px; font-size: 1.85rem; }
.module-card { background: #f6f7fb; border: 1px solid #dfe4ef; border-radius: 18px; }
.filter-panel { display: flex; flex-direction: column; gap: 10px; padding: 12px; border: 1px solid #dde3ef; border-radius: 14px; background: #f1f4f9; }
.filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.filter-row-search { width: 100%; }
.filter-row-controls { width: 100%; }
.soft-input { border-radius: 12px; border: 1px solid #d4daea; background: #fff; min-height: 44px; }
.search-input { width: 100%; }
.date-input { max-width: 170px; }
.filter-label { font-weight: 700; color: #1f2a44; line-height: 1; margin: 0 2px; }
.soft-btn { border-radius: 999px; padding: 8px 14px; font-weight: 700; font-size: 0.95rem; border: 0; }
.soft-btn-primary { background: linear-gradient(135deg, #6c2bd9, #8f4bff); color: #fff; box-shadow: 0 5px 14px rgba(108, 43, 217, 0.3); }
.soft-btn-primary:hover { color: #fff; transform: translateY(-1px); }
.soft-btn-light { background: #ece8ff; color: #6c2bd9; }
.table-wrap { width: 100%; overflow-x: auto; }
.grid-table { display: grid; gap: 5px; }
.grid-contracts-cols { min-width: 1080px; grid-template-columns: minmax(130px, 1fr) minmax(140px, 1.1fr) minmax(110px, 0.85fr) minmax(90px, 0.75fr) minmax(120px, 0.9fr) minmax(120px, 0.9fr) 170px; }
.grid-head { background: #d2d7e0; border: 1px solid #c6cfdd; border-radius: 11px; color: #0d1b3f; font-size: 0.98rem; font-weight: 800; padding: 10px 12px; min-height: 50px; display: flex; align-items: center; }
.grid-cell { background: #f5f7fb; border: 1px solid #dbe2ee; border-radius: 11px; padding: 10px 12px; font-size: 0.95rem; color: #27364f; min-height: 50px; display: flex; align-items: center; }
.grid-empty { grid-column: 1 / -1; background: #f8f9fd; border: 1px dashed #d4dbe8; border-radius: 12px; padding: 22px; text-align: center; color: #64748b; font-weight: 600; }
.actions-cell { white-space: nowrap; }
.action-btn { width: 34px; height: 34px; border-radius: 50%; border: 0; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #7c3aed, #a855f7); color: #fff; margin-right: 6px; box-shadow: 0 3px 8px rgba(124, 58, 237, 0.26); text-decoration: none; }
.actions-cell .action-btn:last-child { margin-right: 0; }
.action-btn:hover { color: #fff; transform: translateY(-1px); }
@media (max-width: 1200px) {
    .date-input { max-width: 170px; }
    .soft-btn { padding: 10px 18px; }
    .grid-contracts-cols { min-width: 940px; }
    .grid-head { font-size: 1rem; }
    .grid-cell { font-size: 0.96rem; }
}
</style>
{% endblock %}
