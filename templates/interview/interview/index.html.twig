{% extends 'base.html.twig' %}

{% block title %}Entretiens{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row g-3">
        <div class="col-lg-3">
            {% include 'interview/_sidebar.html.twig' %}
        </div>
        <div class="col-lg-9">
            <h1 class="module-title mb-4">Entretiens</h1>

            <div class="module-card mb-4">
                <div class="module-card-body">
                    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="text" name="search" class="form-control soft-input" placeholder="Recherche.." value="{{ app.request.query.get('search') ?? '' }}">
                        <span class="filter-label">Du :</span>
                        <input type="date" name="dateFrom" class="form-control soft-input date-input" value="{{ app.request.query.get('dateFrom') ?? '' }}" placeholder="De">
                        <span class="filter-label">Au :</span>
                        <input type="date" name="dateTo" class="form-control soft-input date-input" value="{{ app.request.query.get('dateTo') ?? '' }}" placeholder="À">
                        <button type="submit" class="btn soft-btn soft-btn-primary">Filtrer</button>
                        <a href="{{ path('app_frontoffice_interviews') }}" class="btn soft-btn soft-btn-light">Réinitialiser</a>
                    </form>
                </div>
            </div>

            {% if canManageInterviews|default(false) %}
                <div class="d-flex justify-content-end mb-3">
                    <a href="{{ path('interview_new') }}" class="btn soft-btn soft-btn-primary">Créer un entretien</a>
                </div>
            {% endif %}

            <div class="module-card">
                <div class="module-card-body p-4">
                    <div class="table-wrap">
                        <div class="grid-table grid-interviews-cols">
                            <div class="grid-head">Candidat</div>
                            <div class="grid-head">Entreprise</div>
                            <div class="grid-head">Date</div>
                            <div class="grid-head">Heure</div>
                            <div class="grid-head">Actions</div>

                        {% if interviews is empty %}
                            <div class="grid-empty">Aucun entretien trouvé</div>
                        {% else %}
                            {% for interview in interviews %}
                                <a href="{{ path('interview_show', {id: interview.idInterview}) }}" class="grid-cell cell-link">{{ interview.candidateName }}</a>
                                <a href="{{ path('interview_show', {id: interview.idInterview}) }}" class="grid-cell cell-link">{{ interview.companyName }}</a>
                                <a href="{{ path('interview_show', {id: interview.idInterview}) }}" class="grid-cell cell-link">{{ interview.interviewDate|date('d/m/Y') }}</a>
                                <a href="{{ path('interview_show', {id: interview.idInterview}) }}" class="grid-cell cell-link">{{ (interview.heureDebut ~ '')|slice(0, 5) }} - {{ (interview.heureFin ~ '')|slice(0, 5) }}</a>
                                <div class="grid-cell actions-cell">
                                    {% if canManageInterviews|default(false) %}
                                        <a href="{{ path('interview_edit', {id: interview.idInterview}) }}" class="action-btn" title="Modifier"><i class="bi bi-pencil-square"></i></a>
                                        <form method="post" action="{{ path('interview_delete', {id: interview.idInterview}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ interview.idInterview) }}">
                                            <button type="submit" class="action-btn danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                                        </form>
                                    {% else %}
                                        <a href="{{ path('interview_show', {id: interview.idInterview}) }}" class="action-btn" title="Voir"><i class="bi bi-eye"></i></a>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.module-title { color: #ff6a00; font-weight: 800; letter-spacing: 0.2px; font-size: 1.85rem; }
.module-card { background: #f6f7fb; border: 1px solid #dfe4ef; border-radius: 18px; }
.module-card-body { padding: 12px 14px; }
.soft-input { border-radius: 12px; border: 1px solid #d4daea; background: #fff; min-height: 44px; }
.date-input { max-width: 170px; }
.filter-label { font-weight: 700; color: #1f2a44; }
.soft-btn { border-radius: 999px; padding: 8px 14px; font-weight: 700; font-size: 0.95rem; border: 0; }
.soft-btn-primary { background: linear-gradient(135deg, #6c2bd9, #8f4bff); color: #fff; box-shadow: 0 6px 16px rgba(108, 43, 217, 0.35); }
.soft-btn-primary:hover { color: #fff; transform: translateY(-1px); }
.soft-btn-light { background: #ece8ff; color: #6c2bd9; }
.table-wrap { width: 100%; overflow-x: auto; }
.grid-table { display: grid; gap: 5px; }
.grid-interviews-cols { min-width: 800px; grid-template-columns: minmax(140px, 1.1fr) minmax(140px, 1.1fr) minmax(110px, 0.85fr) minmax(140px, 0.95fr) max-content; }
.grid-head { background: #d2d7e0; border: 1px solid #c6cfdd; border-radius: 11px; color: #0d1b3f; font-size: 0.98rem; font-weight: 800; padding: 10px 12px; min-height: 50px; display: flex; align-items: center; }
.grid-cell { background: #f5f7fb; border: 1px solid #dbe2ee; border-radius: 11px; padding: 10px 12px; font-size: 0.95rem; color: #27364f; min-height: 50px; display: flex; align-items: center; }
.cell-link { text-decoration: none; transition: background .15s ease, border-color .15s ease, color .15s ease; }
.cell-link:hover { background: #edf2ff; border-color: #c6d2f4; color: #1d2f59; }
.grid-empty { grid-column: 1 / -1; background: #f8f9fd; border: 1px dashed #d4dbe8; border-radius: 12px; padding: 22px; text-align: center; color: #64748b; font-weight: 600; }
.actions-cell { white-space: nowrap; padding: 8px 10px; }
.action-btn { width: 34px; height: 34px; border-radius: 50%; border: 0; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #7c3aed, #a855f7); color: #fff; margin-right: 6px; box-shadow: 0 3px 8px rgba(124, 58, 237, 0.26); text-decoration: none; }
.actions-cell .action-btn:last-child { margin-right: 0; }
.action-btn.danger { background: linear-gradient(135deg, #ef4444, #dc2626); }
.action-btn:hover { color: #fff; transform: translateY(-1px); }
</style>
{% endblock %}
