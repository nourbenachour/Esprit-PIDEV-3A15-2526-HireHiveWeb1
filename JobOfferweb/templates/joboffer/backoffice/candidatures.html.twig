{% extends 'admin/base_admin.html.twig' %}

{% block title %}📨 Candidatures - {{ offre.title }} - Backoffice{% endblock %}

{% block backoffice_content %}
<style>
    .cand-page { display: flex; flex-direction: column; gap: 16px; }

    .cand-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
        border-radius: 16px; padding: 24px 28px; color: #fff;
        position: relative; overflow: hidden;
    }
    .cand-hero::after {
        content: '📨'; position: absolute; right: 24px; top: 50%;
        transform: translateY(-50%); font-size: 56px; opacity: 0.15;
    }
    .cand-hero h2 { margin: 0; font-size: 20px; font-weight: 900; }
    .cand-hero p { margin: 6px 0 0; font-size: 14px; opacity: 0.8; }
    .cand-hero-stats {
        display: flex; gap: 16px; margin-top: 14px; flex-wrap: wrap;
    }
    .cand-hero-stat {
        background: rgba(255,255,255,0.12); backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.15); border-radius: 10px;
        padding: 8px 16px; font-size: 13px; font-weight: 700;
    }

    .cand-grid { display: flex; flex-direction: column; gap: 12px; }

    .cand-item {
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        background: var(--card); border: 1px solid var(--border); border-radius: 14px;
        padding: 18px 20px; transition: all 0.2s ease;
    }
    .cand-item:hover { border-color: #374151; transform: translateX(4px); box-shadow: 0 4px 16px rgba(0,0,0,0.15); }

    .cand-avatar {
        width: 48px; height: 48px; border-radius: 14px;
        display: grid; place-items: center; font-weight: 900; font-size: 18px;
        flex-shrink: 0; border: 2px solid var(--border);
    }
    .cand-avatar.c0 { background: linear-gradient(135deg, #7c3aed, #a78bfa); color: #fff; }
    .cand-avatar.c1 { background: linear-gradient(135deg, #0ea5e9, #38bdf8); color: #fff; }
    .cand-avatar.c2 { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #fff; }
    .cand-avatar.c3 { background: linear-gradient(135deg, #10b981, #34d399); color: #fff; }

    .cand-info { flex: 1; min-width: 180px; }
    .cand-name { font-size: 15px; font-weight: 900; color: var(--text); }
    .cand-email { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .cand-lettre {
        margin-top: 6px; font-size: 12px; color: #9ca3af; font-style: italic;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        background: #0f172a; border-radius: 8px; padding: 8px 10px; border: 1px solid var(--border);
    }

    .cand-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .cand-date { font-size: 11px; color: var(--muted); }
    .cand-status {
        padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 800;
        border: 1px solid var(--border);
    }
    .cand-status.pending { background: #422006; color: #fcd34d; border-color: #92400e; }
    .cand-status.accepted { background: #0d3320; color: #4ade80; border-color: #166534; }
    .cand-status.rejected { background: #3b1219; color: #fb7185; border-color: #9f1239; }

    .cand-actions { display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap; }
    .cand-actions form { display: inline; }
    .cand-btn {
        padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700;
        cursor: pointer; border: 1px solid; transition: all 0.15s ease;
    }
    .cand-btn-accept { background: #0d3320; color: #4ade80; border-color: #166534; }
    .cand-btn-accept:hover { background: #15803d; }
    .cand-btn-reject { background: #3b1219; color: #fb7185; border-color: #9f1239; }
    .cand-btn-reject:hover { background: #be123c; }
    .cand-btn-cv {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700;
        background: #162032; color: #38bdf8; border: 1px solid #0369a1;
        text-decoration: none;
    }
    .cand-btn-cv:hover { background: #1e3a5f; }

    .cand-empty {
        text-align: center; padding: 40px; color: var(--muted);
        border: 1px dashed var(--border); border-radius: 14px;
        background: var(--card);
    }
    .cand-empty .empty-icon { font-size: 40px; margin-bottom: 8px; }
</style>

<div class="cand-page">
    <!-- Hero -->
    <div class="cand-hero">
        <h2>📨 Candidatures pour : {{ offre.title }}</h2>
        <p>📍 {{ offre.location }} • 📋 {{ offre.contract_type }}</p>
        <div class="cand-hero-stats">
            <span class="cand-hero-stat">👥 {{ applications|length }} candidature{{ applications|length > 1 ? 's' : '' }}</span>
            <span class="cand-hero-stat">⏳ {{ applications|filter(a => a.status == 'PENDING')|length }} en attente</span>
            <span class="cand-hero-stat">✅ {{ applications|filter(a => a.status == 'ACCEPTED')|length }} acceptée{{ applications|filter(a => a.status == 'ACCEPTED')|length > 1 ? 's' : '' }}</span>
        </div>
    </div>

    <a href="{{ path('app_joboffer_back_list') }}" class="btn btn-ghost">⬅️ Retour aux offres</a>

    {% for message in app.flashes('success') %}
        <div style="background:#0d3320; color:#4ade80; border:1px solid #166534; border-radius:10px; padding:12px 16px; font-size:13px; font-weight:600;">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background:#3b1219; color:#fb7185; border:1px solid #9f1239; border-radius:10px; padding:12px 16px; font-size:13px; font-weight:600;">❌ {{ message }}</div>
    {% endfor %}

    <!-- Candidatures -->
    <div class="cand-grid">
        {% for a in applications %}
            {% set sc = a.status|lower == 'accepted' ? 'accepted' : (a.status|lower == 'rejected' ? 'rejected' : 'pending') %}
            {% set initials = (a.first_name|default('?'))|first ~ (a.last_name|default('?'))|first %}
            <div class="cand-item">
                <div class="cand-avatar c{{ loop.index0 % 4 }}">{{ initials|upper }}</div>
                <div class="cand-info">
                    <div class="cand-name">👤 {{ a.first_name|default('') }} {{ a.last_name|default('') }}</div>
                    <div class="cand-email">✉️ {{ a.email|default('—') }}</div>
                    {% if a.lettre is defined and a.lettre %}
                        <div class="cand-lettre">💬 "{{ a.lettre }}"</div>
                    {% endif %}
                </div>
                <div class="cand-right">
                    {% if a.application_date is defined and a.application_date %}
                        <div class="cand-date">📅 {{ a.application_date|date('d/m/Y') }}</div>
                    {% endif %}
                    <span class="cand-status {{ sc }}">
                        {% if sc == 'accepted' %}✅{% elseif sc == 'rejected' %}❌{% else %}⏳{% endif %}
                        {{ a.status }}
                    </span>
                    {% if a.cv_file_path is defined and a.cv_file_path %}
                        <a href="{{ a.cv_file_path }}" target="_blank" class="cand-btn-cv">📄 Voir CV</a>
                    {% endif %}
                    <div class="cand-actions">
                        {% if a.status != 'ACCEPTED' %}
                            <form method="post" action="{{ path('app_joboffer_back_candidature_status', {id: a.id_condidature}) }}">
                                <input type="hidden" name="status" value="ACCEPTED">
                                <button type="submit" class="cand-btn cand-btn-accept">✅ Accepter</button>
                            </form>
                        {% endif %}
                        {% if a.status != 'REJECTED' %}
                            <form method="post" action="{{ path('app_joboffer_back_candidature_status', {id: a.id_condidature}) }}">
                                <input type="hidden" name="status" value="REJECTED">
                                <button type="submit" class="cand-btn cand-btn-reject">❌ Refuser</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="cand-empty">
                <div class="empty-icon">🕊️</div>
                <p style="font-weight:700; margin:0;">Aucune candidature pour cette offre.</p>
                <p style="color:var(--muted); margin:4px 0 0; font-size:13px;">Les candidats n'ont pas encore postulé.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
