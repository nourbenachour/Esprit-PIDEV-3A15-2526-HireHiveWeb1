{% extends 'admin/base_admin.html.twig' %}

{% block title %}💼 Offres d'emploi - Backoffice{% endblock %}

{% block backoffice_content %}
<style>
    .bo-offers { display: flex; flex-direction: column; gap: 16px; }
    .bo-offers-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .bo-offers-header h2 { margin: 0; font-size: 22px; color: var(--text); }
    .bo-offers-header h2 span { font-size: 14px; color: var(--muted); font-weight: 400; }
    .bo-stats-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .bo-stat-pill {
        display: flex; align-items: center; gap: 8px;
        background: #1a1f2e; border: 1px solid var(--border); border-radius: 10px;
        padding: 10px 16px; min-width: 140px;
    }
    .bo-stat-pill .stat-icon { font-size: 22px; }
    .bo-stat-pill .stat-num { font-size: 20px; font-weight: 800; color: var(--text); }
    .bo-stat-pill .stat-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }

    /* Filters */
    .bo-filters {
        display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;
        padding: 14px 16px; background: #1a1f2e; border: 1px solid var(--border); border-radius: 12px;
    }
    .bo-filters .fg { display: flex; flex-direction: column; gap: 4px; }
    .bo-filters label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; }
    .bo-filters input, .bo-filters select {
        background: #0f172a; color: var(--text); border: 1px solid var(--border);
        border-radius: 8px; padding: 9px 12px; font-size: 13px; min-width: 160px;
    }
    .bo-filters input:focus, .bo-filters select:focus {
        outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(124,58,237,0.18);
    }

    /* Offer Cards */
    .bo-offer-card {
        background: var(--card); border: 1px solid var(--border); border-radius: 14px;
        overflow: hidden; transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .bo-offer-card:hover { border-color: #374151; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
    .bo-offer-card.expanded { border-color: var(--accent); box-shadow: 0 4px 24px rgba(124,58,237,0.15); }

    .bo-card-head {
        display: flex; align-items: center; gap: 14px; padding: 16px 20px;
        cursor: pointer; transition: background 0.15s ease; flex-wrap: wrap;
    }
    .bo-card-head:hover { background: rgba(124,58,237,0.04); }

    .bo-card-icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: grid; place-items: center; font-size: 20px; flex-shrink: 0;
    }
    .bo-card-icon.open { background: linear-gradient(135deg, #065f46, #10b981); }
    .bo-card-icon.closed { background: linear-gradient(135deg, #9f1239, #fb7185); }
    .bo-card-icon.draft { background: linear-gradient(135deg, #374151, #6b7280); }

    .bo-card-info { flex: 1; min-width: 200px; }
    .bo-card-title { margin: 0; font-size: 16px; font-weight: 800; color: var(--text); }
    .bo-card-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
    .bo-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 700;
        background: #1a1f2e; color: var(--muted); border: 1px solid var(--border);
    }
    .bo-chip.loc { color: #4ade80; border-color: #166534; }
    .bo-chip.contract { color: var(--accent-2); border-color: #4c1d95; }
    .bo-chip.date { color: #38bdf8; border-color: #0369a1; }

    .bo-card-badges { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .bo-badge-status {
        padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 800;
        letter-spacing: 0.3px; border: 1px solid var(--border);
    }
    .bo-badge-status.open { background: #0d3320; color: #4ade80; border-color: #166534; }
    .bo-badge-status.closed { background: #3b1219; color: #fb7185; border-color: #9f1239; }
    .bo-badge-status.draft { background: #1a1f2e; color: var(--muted); }
    .bo-cand-count {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700;
        background: #162032; color: #a78bfa; border: 1px solid #4c1d95;
    }
    .bo-expand-arrow {
        font-size: 18px; color: var(--muted); transition: transform 0.3s ease;
    }
    .bo-offer-card.expanded .bo-expand-arrow { transform: rotate(180deg); color: var(--accent); }

    /* Actions bar */
    .bo-card-actions {
        display: flex; gap: 6px; padding: 0 20px 14px; flex-wrap: wrap;
    }
    .bo-action-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 700;
        background: #0f172a; color: var(--text); border: 1px solid var(--border);
        cursor: pointer; text-decoration: none; transition: all 0.15s ease;
    }
    .bo-action-btn:hover { background: #1a1f2e; border-color: #4b5563; }
    .bo-action-btn.danger { color: #fb7185; border-color: #9f1239; }
    .bo-action-btn.danger:hover { background: #3b1219; }
    .bo-action-btn.primary { color: var(--accent-2); border-color: var(--accent); }
    .bo-action-btn.primary:hover { background: #1e1145; }

    /* Candidatures Drawer */
    .bo-cand-drawer {
        max-height: 0; overflow: hidden;
        transition: max-height 0.4s cubic-bezier(0.4,0,0.2,1);
        background: #0d1117; border-top: 1px solid transparent;
    }
    .bo-offer-card.expanded .bo-cand-drawer {
        max-height: 2000px; border-top-color: var(--border);
    }
    .bo-cand-drawer-inner { padding: 16px 20px 20px; }
    .bo-cand-drawer-title {
        margin: 0 0 14px; font-size: 14px; font-weight: 800; color: var(--accent-2);
        display: flex; align-items: center; gap: 6px;
    }

    /* Candidature cards inside drawer */
    .bo-cand-grid { display: flex; flex-direction: column; gap: 10px; }
    .bo-cand-item {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        background: #111827; border: 1px solid var(--border); border-radius: 12px;
        padding: 14px 16px; transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .bo-cand-item:hover { border-color: #374151; transform: translateX(3px); }

    .bo-cand-avatar {
        width: 42px; height: 42px; border-radius: 50%;
        display: grid; place-items: center; font-weight: 800; font-size: 16px;
        flex-shrink: 0; border: 2px solid var(--border);
    }
    .bo-cand-avatar.a0 { background: linear-gradient(135deg, #7c3aed, #a78bfa); color: #fff; }
    .bo-cand-avatar.a1 { background: linear-gradient(135deg, #0ea5e9, #38bdf8); color: #fff; }
    .bo-cand-avatar.a2 { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #fff; }
    .bo-cand-avatar.a3 { background: linear-gradient(135deg, #10b981, #34d399); color: #fff; }

    .bo-cand-info { flex: 1; min-width: 160px; }
    .bo-cand-name { font-size: 14px; font-weight: 800; color: var(--text); }
    .bo-cand-email { font-size: 12px; color: var(--muted); }
    .bo-cand-lettre {
        margin-top: 4px; font-size: 12px; color: #9ca3af; font-style: italic;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .bo-cand-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .bo-cand-date { font-size: 11px; color: var(--muted); }
    .bo-cand-status {
        padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 800;
        border: 1px solid var(--border);
    }
    .bo-cand-status.pending { background: #422006; color: #fcd34d; border-color: #92400e; }
    .bo-cand-status.accepted { background: #0d3320; color: #4ade80; border-color: #166534; }
    .bo-cand-status.rejected { background: #3b1219; color: #fb7185; border-color: #9f1239; }

    .bo-cand-actions { display: flex; gap: 6px; margin-top: 6px; }
    .bo-cand-actions form { display: inline; }
    .bo-btn-sm {
        padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 700;
        cursor: pointer; border: 1px solid; transition: all 0.15s ease;
    }
    .bo-btn-accept { background: #0d3320; color: #4ade80; border-color: #166534; }
    .bo-btn-accept:hover { background: #15803d; }
    .bo-btn-reject { background: #3b1219; color: #fb7185; border-color: #9f1239; }
    .bo-btn-reject:hover { background: #be123c; }
    .bo-btn-cv {
        display: inline-flex; align-items: center; gap: 3px;
        padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 700;
        background: #162032; color: #38bdf8; border: 1px solid #0369a1;
        text-decoration: none;
    }
    .bo-btn-cv:hover { background: #1e3a5f; }

    .bo-empty-cand {
        text-align: center; padding: 20px; color: var(--muted); font-size: 13px;
        border: 1px dashed var(--border); border-radius: 10px;
    }
    .bo-empty-offers {
        text-align: center; padding: 40px; color: var(--muted); font-size: 14px;
        background: var(--card); border: 1px dashed var(--border); border-radius: 14px;
    }
</style>

<div class="bo-offers">
    <!-- Header -->
    <div class="bo-offers-header">
        <div>
            <h2>💼 Offres d'emploi <span>— Gestion & Candidatures</span></h2>
        </div>
        <a href="{{ path('app_joboffer_back_new') }}" class="btn btn-primary">➕ Nouvelle offre</a>
    </div>

    <!-- Stats -->
    {% set total_offers = offers|length %}
    {% set open_count = offers|filter(o => o.status == 'OPEN')|length %}
    {% set closed_count = offers|filter(o => o.status == 'CLOSED')|length %}
    {% set total_cands = 0 %}
    {% for id, cands in candidatures_map %}{% set total_cands = total_cands + cands|length %}{% endfor %}

    <div class="bo-stats-row">
        <div class="bo-stat-pill">
            <span class="stat-icon">📊</span>
            <div><div class="stat-num">{{ total_offers }}</div><div class="stat-label">Total Offres</div></div>
        </div>
        <div class="bo-stat-pill">
            <span class="stat-icon">🟢</span>
            <div><div class="stat-num">{{ open_count }}</div><div class="stat-label">Ouvertes</div></div>
        </div>
        <div class="bo-stat-pill">
            <span class="stat-icon">🔴</span>
            <div><div class="stat-num">{{ closed_count }}</div><div class="stat-label">Fermées</div></div>
        </div>
        <div class="bo-stat-pill">
            <span class="stat-icon">👥</span>
            <div><div class="stat-num">{{ total_cands }}</div><div class="stat-label">Candidatures</div></div>
        </div>
    </div>

    <!-- Flash -->
    {% for message in app.flashes('success') %}
        <div style="background:#0d3320; color:#4ade80; border:1px solid #166534; border-radius:10px; padding:12px 16px; font-size:13px; font-weight:600;">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background:#3b1219; color:#fb7185; border:1px solid #9f1239; border-radius:10px; padding:12px 16px; font-size:13px; font-weight:600;">❌ {{ message }}</div>
    {% endfor %}

    <!-- Filters -->
    <form method="get" class="bo-filters">
        <div class="fg" style="flex:1; min-width:200px;">
            <label for="filter-q">🔍 Recherche</label>
            <input id="filter-q" type="text" name="q" value="{{ filter_query }}" placeholder="Titre, description, lieu...">
        </div>
        <div class="fg">
            <label for="filter-status">📌 Statut</label>
            <select name="status" id="filter-status">
                <option value="">Tous</option>
                <option value="OPEN" {{ filter_status == 'OPEN' ? 'selected' : '' }}>🟢 OPEN</option>
                <option value="CLOSED" {{ filter_status == 'CLOSED' ? 'selected' : '' }}>🔴 CLOSED</option>
                <option value="DRAFT" {{ filter_status == 'DRAFT' ? 'selected' : '' }}>📝 DRAFT</option>
            </select>
        </div>
        <div class="fg">
            <label for="filter-ct">📋 Contrat</label>
            <select name="contract_type" id="filter-ct">
                <option value="">Tous</option>
                <option value="CDI" {{ filter_contract_type == 'CDI' ? 'selected' : '' }}>CDI</option>
                <option value="CDD" {{ filter_contract_type == 'CDD' ? 'selected' : '' }}>CDD</option>
                <option value="Stage" {{ filter_contract_type == 'Stage' ? 'selected' : '' }}>Stage</option>
                <option value="Freelance" {{ filter_contract_type == 'Freelance' ? 'selected' : '' }}>Freelance</option>
            </select>
        </div>
        <div style="display:flex; gap:8px; align-items:flex-end;">
            <button type="submit" class="btn btn-primary">Filtrer</button>
            <a class="btn btn-ghost" href="{{ path('app_joboffer_back_list') }}">Réinitialiser</a>
        </div>
    </form>

    <!-- Offers list -->
    {% for o in offers %}
        {% set status_class = o.status|lower == 'open' ? 'open' : (o.status|lower == 'closed' ? 'closed' : 'draft') %}
        {% set cands = candidatures_map[o.id_job_offer] | default([]) %}
        <div class="bo-offer-card" id="offer-card-{{ o.id_job_offer }}">
            <!-- Card Head — clickable to toggle candidatures -->
            <div class="bo-card-head" onclick="toggleCandidatures({{ o.id_job_offer }})">
                <div class="bo-card-icon {{ status_class }}">
                    {% if status_class == 'open' %}🚀{% elseif status_class == 'closed' %}🔒{% else %}📝{% endif %}
                </div>
                <div class="bo-card-info">
                    <h3 class="bo-card-title">{{ o.title }}</h3>
                    <div class="bo-card-meta">
                        <span class="bo-chip loc">📍 {{ o.location }}</span>
                        <span class="bo-chip contract">📋 {{ o.contract_type }}</span>
                        {% if o.created_at is defined and o.created_at %}
                            <span class="bo-chip date">🕐 {{ o.created_at|date('d/m/Y') }}</span>
                        {% endif %}
                        {% if o.skills is defined and o.skills %}
                            <span class="bo-chip" style="color:#e879f9; border-color:#a21caf;">🎯 {{ o.skills|length > 30 ? o.skills|slice(0,30) ~ '…' : o.skills }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="bo-card-badges">
                    <span class="bo-badge-status {{ status_class }}">{{ o.status }}</span>
                    <span class="bo-cand-count">👥 {{ cands|length }}</span>
                    <span class="bo-expand-arrow">▼</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="bo-card-actions">
                <a href="{{ path('app_joboffer_back_edit', {id: o.id_job_offer}) }}" class="bo-action-btn primary">✏️ Modifier</a>
                <form method="post" action="{{ path('app_joboffer_back_delete', {id: o.id_job_offer}) }}" style="display:inline" onsubmit="return confirm('⚠️ Supprimer cette offre et toutes ses candidatures ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_offre_' ~ o.id_job_offer) }}">
                    <button type="submit" class="bo-action-btn danger">🗑️ Supprimer</button>
                </form>
            </div>

            <!-- Candidatures Drawer -->
            <div class="bo-cand-drawer" id="drawer-{{ o.id_job_offer }}">
                <div class="bo-cand-drawer-inner">
                    <div class="bo-cand-drawer-title">📨 Candidatures pour cette offre ({{ cands|length }})</div>

                    {% if cands|length > 0 %}
                        <div class="bo-cand-grid">
                            {% for a in cands %}
                                {% set sc = a.status|lower == 'accepted' ? 'accepted' : (a.status|lower == 'rejected' ? 'rejected' : 'pending') %}
                                {% set initials = (a.first_name|default('?'))|first ~ (a.last_name|default('?'))|first %}
                                <div class="bo-cand-item">
                                    <div class="bo-cand-avatar a{{ loop.index0 % 4 }}">{{ initials|upper }}</div>
                                    <div class="bo-cand-info">
                                        <div class="bo-cand-name">👤 {{ a.first_name|default('') }} {{ a.last_name|default('') }}</div>
                                        <div class="bo-cand-email">✉️ {{ a.email|default('—') }}</div>
                                        {% if a.lettre is defined and a.lettre %}
                                            <div class="bo-cand-lettre">💬 "{{ a.lettre }}"</div>
                                        {% endif %}
                                    </div>
                                    <div class="bo-cand-right">
                                        {% if a.application_date is defined and a.application_date %}
                                            <div class="bo-cand-date">📅 {{ a.application_date|date('d/m/Y') }}</div>
                                        {% endif %}
                                        <span class="bo-cand-status {{ sc }}">
                                            {% if sc == 'accepted' %}✅{% elseif sc == 'rejected' %}❌{% else %}⏳{% endif %}
                                            {{ a.status }}
                                        </span>
                                        {% if a.cv_file_path is defined and a.cv_file_path %}
                                            <a href="{{ a.cv_file_path }}" target="_blank" class="bo-btn-cv">📄 Voir CV</a>
                                        {% endif %}
                                        <div class="bo-cand-actions">
                                            {% if a.status != 'ACCEPTED' %}
                                                <form method="post" action="{{ path('app_joboffer_back_candidature_status', {id: a.id_condidature}) }}">
                                                    <input type="hidden" name="status" value="ACCEPTED">
                                                    <button type="submit" class="bo-btn-sm bo-btn-accept">✅ Accepter</button>
                                                </form>
                                            {% endif %}
                                            {% if a.status != 'REJECTED' %}
                                                <form method="post" action="{{ path('app_joboffer_back_candidature_status', {id: a.id_condidature}) }}">
                                                    <input type="hidden" name="status" value="REJECTED">
                                                    <button type="submit" class="bo-btn-sm bo-btn-reject">❌ Refuser</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="bo-empty-cand">🕊️ Aucune candidature reçue pour cette offre.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="bo-empty-offers">
            <p style="font-size:28px; margin:0 0 8px;">📭</p>
            <p>Aucune offre ne correspond à ces filtres.</p>
        </div>
    {% endfor %}
</div>

<script>
function toggleCandidatures(offerId) {
    const card = document.getElementById('offer-card-' + offerId);
    card.classList.toggle('expanded');
}
</script>
{% endblock %}
