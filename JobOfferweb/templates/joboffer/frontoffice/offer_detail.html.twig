{% extends 'base.html.twig' %}

{% block title %}🚀 {{ offre.title }} - HireHive{% endblock %}

{% block content %}
<style>
.detail-page { max-width: 820px; margin: 0 auto; }
.detail-back {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--accent); font-weight: 800; font-size: 14px;
    text-decoration: none; margin-bottom: 16px;
    padding: 8px 14px; border-radius: 10px;
    background: #f5f3ff; border: 1px solid #e4ddff;
    transition: all 0.2s ease;
}
.detail-back:hover { background: #ede9fe; transform: translateX(-3px); }

/* Hero Card */
.detail-hero {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #c084fc 100%);
    border-radius: 20px;
    padding: 30px 32px;
    margin-bottom: 20px;
    color: #fff;
    position: relative;
    overflow: hidden;
}
.detail-hero::after {
    content: '🚀';
    position: absolute;
    right: 28px; top: 50%;
    transform: translateY(-50%);
    font-size: 70px;
    opacity: 0.15;
}
.detail-hero-title { margin: 0; font-size: 28px; font-weight: 900; }
.detail-hero-meta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
.detail-hero-tag {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 6px 14px; border-radius: 999px;
    font-size: 13px; font-weight: 700;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.25);
}

/* Content card */
.detail-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 28px 30px;
    margin-bottom: 18px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}
.detail-section-title {
    font-size: 16px; font-weight: 900; color: #1f2937;
    margin: 20px 0 10px;
    display: flex; align-items: center; gap: 8px;
    padding-bottom: 8px;
    border-bottom: 2px solid #f3f0ff;
}
.detail-desc {
    color: #4b5563; font-size: 15px; line-height: 1.8;
    white-space: pre-line;
    background: #f9fafb; border-radius: 12px;
    padding: 16px 18px;
    border: 1px solid #f3f4f6;
}
.detail-skills { display: flex; flex-wrap: wrap; gap: 8px; }
.skill-chip {
    padding: 6px 14px; border-radius: 10px;
    font-size: 12px; font-weight: 700;
    background: linear-gradient(135deg, #ede9fe, #f5f3ff);
    color: #5b21b6; border: 1px solid #e4ddff;
    transition: all 0.15s ease;
}
.skill-chip:hover { transform: translateY(-2px); box-shadow: 0 3px 10px rgba(124,58,237,0.12); }
.skill-chip.soft {
    background: linear-gradient(135deg, #fef3c7, #fffbeb);
    color: #92400e; border-color: #fcd34d;
}
.skill-chip.soft:hover { box-shadow: 0 3px 10px rgba(245,158,11,0.12); }

/* Apply section */
.apply-section {
    background: linear-gradient(135deg, #f9fafb 0%, #f3f0ff 100%);
    border: 2px solid #e4ddff;
    border-radius: 20px;
    padding: 28px 30px;
    margin-top: 20px;
    position: relative;
}
.apply-title {
    margin: 0 0 16px; font-size: 20px; font-weight: 900; color: #1f2937;
    display: flex; align-items: center; gap: 8px;
}
.apply-form .fg { display: flex; flex-direction: column; gap: 5px; margin-bottom: 16px; }
.apply-form label {
    font-size: 13px; font-weight: 800; color: #374151;
    display: flex; align-items: center; gap: 4px;
}
.apply-form textarea, .apply-form input[type="file"] {
    padding: 12px 14px;
    border: 2px solid #d1d5db;
    border-radius: 12px;
    font-size: 14px;
    background: #fff;
    color: #1f2937;
    font-family: inherit;
    transition: all 0.2s ease;
}
.apply-form textarea { min-height: 130px; resize: vertical; }
.apply-form textarea:focus, .apply-form input[type="file"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(124,58,237,0.12);
}
.field-error { border-color: #ef4444 !important; }
.error-msg { color: #ef4444; font-size: 12px; min-height: 16px; }

.applied-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 16px 24px; border-radius: 14px;
    background: linear-gradient(135deg, #d1fae5, #ecfdf5);
    color: #065f46; font-weight: 800; font-size: 15px;
    border: 2px solid #6ee7b7;
    box-shadow: 0 4px 14px rgba(16,185,129,0.15);
}

.btn-submit {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px; border-radius: 14px;
    background: linear-gradient(135deg, var(--accent), #a855f7);
    color: #fff; font-weight: 800; font-size: 15px;
    border: none; cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(124,58,237,0.3);
}
.btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(124,58,237,0.4); }

.closed-notice {
    display: flex; align-items: center; gap: 10px;
    padding: 16px 20px; border-radius: 14px;
    background: #fef2f2; color: #991b1b;
    font-weight: 700; font-size: 14px;
    border: 1px solid #fecaca;
}
</style>

<div class="detail-page">
    <a href="{{ path('app_joboffer_front_list') }}" class="detail-back">⬅️ Retour aux offres</a>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash flash-error">❌ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="flash flash-warning">⚠️ {{ message }}</div>
    {% endfor %}

    <!-- Hero -->
    <div class="detail-hero">
        <h1 class="detail-hero-title">{{ offre.title }}</h1>
        <div class="detail-hero-meta">
            <span class="detail-hero-tag">📍 {{ offre.location }}</span>
            <span class="detail-hero-tag">📋 {{ offre.contract_type }}</span>
            <span class="detail-hero-tag">
                {% if offre.status == 'OPEN' %}🟢{% elseif offre.status == 'CLOSED' %}🔴{% else %}📝{% endif %}
                {{ offre.status }}
            </span>
            {% if offre.created_at is defined and offre.created_at %}
                <span class="detail-hero-tag">🕐 {{ offre.created_at|date('d/m/Y') }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Details Card -->
    <div class="detail-card">
        <div class="detail-section-title">📝 Description</div>
        <p class="detail-desc">{{ offre.description }}</p>

        {% if offre.skills is defined and offre.skills %}
        <div class="detail-section-title">🎯 Compétences requises</div>
        <div class="detail-skills">
            {% for skill in offre.skills|split(',') %}
                <span class="skill-chip">{{ skill|trim }}</span>
            {% endfor %}
        </div>
        {% endif %}

        {% if offre.soft_skills is defined and offre.soft_skills %}
        <div class="detail-section-title">💡 Soft Skills</div>
        <div class="detail-skills">
            {% for skill in offre.soft_skills|split(',') %}
                <span class="skill-chip soft">{{ skill|trim }}</span>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <!-- Apply Section -->
    <div class="apply-section" id="apply">
        {% if has_applied %}
            <div class="applied-badge">✅ Vous avez déjà postulé à cette offre — bonne chance ! 🍀</div>
        {% elseif offre.status != 'OPEN' %}
            <div class="closed-notice">🔒 Cette offre n'accepte plus de candidatures.</div>
        {% else %}
            <h3 class="apply-title">✉️ Postuler à cette offre</h3>
            <form method="post" action="{{ path('app_joboffer_front_apply', {id: offre.id_job_offer}) }}" enctype="multipart/form-data" class="apply-form" id="applyForm" novalidate>
                <div class="fg">
                    <label for="apply-lettre">💬 Lettre de motivation *</label>
                    <textarea id="apply-lettre" name="lettre" required minlength="20" placeholder="Décrivez votre motivation et pourquoi vous êtes le candidat idéal ✨ (min 20 caractères)..."></textarea>
                    <span class="error-msg" id="err-lettre"></span>
                </div>
                <div class="fg">
                    <label for="apply-cv">📄 CV (PDF uniquement) *</label>
                    <input type="file" id="apply-cv" name="cv_file" accept="application/pdf" required>
                    <span class="error-msg" id="err-cv"></span>
                </div>
                <button type="submit" class="btn-submit" id="btn-apply-submit">🚀 Envoyer ma candidature →</button>
            </form>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('applyForm');
    if (!form) return;

    const lettreEl = document.getElementById('apply-lettre');
    const cvEl = document.getElementById('apply-cv');

    function validateLettre() {
        const val = lettreEl.value.trim();
        const err = document.getElementById('err-lettre');
        let msg = '';
        if (val.length < 20) msg = '⚠️ La lettre de motivation est obligatoire (min 20 caractères).';
        else if (!/\p{L}/u.test(val)) msg = '⚠️ La lettre doit contenir au moins une lettre.';
        err.textContent = msg;
        lettreEl.classList.toggle('field-error', msg !== '');
        return msg === '';
    }

    function validateCv() {
        const err = document.getElementById('err-cv');
        let msg = '';
        if (!cvEl.files || cvEl.files.length === 0) {
            msg = '⚠️ Le CV est obligatoire (fichier PDF).';
        } else if (cvEl.files[0].type !== 'application/pdf') {
            msg = '⚠️ Le CV doit être au format PDF.';
        }
        err.textContent = msg;
        cvEl.classList.toggle('field-error', msg !== '');
        return msg === '';
    }

    lettreEl.addEventListener('input', validateLettre);
    lettreEl.addEventListener('blur', validateLettre);
    cvEl.addEventListener('change', validateCv);

    form.addEventListener('submit', function(e) {
        const a = validateLettre();
        const b = validateCv();
        if (!a || !b) e.preventDefault();
    });
});
</script>
{% endblock %}
