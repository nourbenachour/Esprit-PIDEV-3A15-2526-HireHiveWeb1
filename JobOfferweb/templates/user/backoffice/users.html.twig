{% extends 'admin/base_admin.html.twig' %}

{% block title %}Utilisateurs - Backoffice{% endblock %}

{% block backoffice_content %}
<style>
    .user-page { display: flex; flex-direction: column; gap: 12px; }
    .user-page-header { display: flex; align-items: center; gap: 12px; }
    .user-page-title { margin: 0; font-size: 18px; color: var(--text); }
    .user-page-subtitle { margin: 2px 0 0; color: var(--muted); font-size: 14px; }
    .user-table-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }
    .table-simple { width: 100%; border-collapse: collapse; color: var(--text); }
    .table-simple th, .table-simple td {
        padding: 11px 10px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
        text-align: left;
    }
    .table-simple th {
        background: #1a1f2e;
        color: var(--text);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.3px;
    }
    .table-simple tr:hover td { background: #111e32; }
    .badge-status, .badge-role, .badge-active {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid var(--border);
        background: #1a1f2e;
        color: var(--text);
    }
    .badge-role.admin { background: #1f1530; color: var(--text); border-color: var(--border); }
    .badge-role.recruiter { background: #162032; color: var(--text); border-color: var(--border); }
    .badge-role.candidate { background: #1a1f2e; color: var(--accent); border-color: var(--border); }
    .badge-status { background: #162032; color: var(--text); border-color: var(--border); }
    .badge-active { background: #1a1f2e; color: var(--accent); border-color: var(--border); }
    .actions-inline { display: flex; gap: 8px; align-items: center; }
    .sortable { color: var(--text); text-decoration: none; }
    .sortable:hover { text-decoration: underline; }
    .form-select, .form-input {
        background: #0f172a;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 10px;
        min-width: 150px;
    }
    .form-label { display:block; margin-bottom:4px; color: var(--muted); font-size: 12px; }
</style>

<div class="user-page">
    <div class="user-page-header">
        <div>
            <h2 class="user-page-title">Utilisateurs</h2>
            <p class="user-page-subtitle">Comptes, rôles et statuts des membres</p>
            <small class="text-muted">{{ users|length }} résultat{{ users|length > 1 ? 's' : '' }}</small>
        </div>
        <div style="margin-left:auto;">
            <a href="{{ path('app_backoffice_users_new') }}" class="btn btn-primary">Ajouter</a>
        </div>
    </div>

    {% set rolesAvailable = roles_available is defined and roles_available ? roles_available : ['ADMIN','RECRUITER','CANDIDATE','USER'] %}
    {% set q = filter_query|default('') %}

    <form method="get" class="filters-row" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div style="min-width:220px;">
            <label class="form-label" for="filter-q">Recherche</label>
            <input id="filter-q" class="form-input" type="text" name="q" value="{{ q }}" placeholder="Nom, email, téléphone...">
        </div>
        <div>
            <label class="form-label" for="filter-role">Rôle</label>
            <select name="role" id="filter-role" class="form-select">
                <option value="">Tous</option>
                {% for r in rolesAvailable %}
                    <option value="{{ r }}" {{ filter_role|upper == r|upper ? 'selected' : '' }}>{{ r|upper }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="form-label" for="filter-sort">Trier par</label>
            <select name="sort" id="filter-sort" class="form-select">
                <option value="created_at" {{ filter_sort == 'created_at' ? 'selected' : '' }}>Date de création</option>
                <option value="status" {{ filter_sort == 'status' ? 'selected' : '' }}>Statut</option>
                <option value="first_name" {{ filter_sort == 'first_name' ? 'selected' : '' }}>Prénom</option>
                <option value="last_name" {{ filter_sort == 'last_name' ? 'selected' : '' }}>Nom</option>
                <option value="email" {{ filter_sort == 'email' ? 'selected' : '' }}>Email</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="filter-direction">Ordre</label>
            <select name="direction" id="filter-direction" class="form-select">
                <option value="ASC" {{ filter_direction|upper == 'ASC' ? 'selected' : '' }}>Ascendant</option>
                <option value="DESC" {{ filter_direction|upper == 'DESC' ? 'selected' : '' }}>Descendant</option>
            </select>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn-primary">Filtrer</button>
            <a class="btn btn-ghost" href="{{ path('app_backoffice_users') }}">Réinitialiser</a>
        </div>
    </form>

{% set baseParams = {
    q: q,
    role: filter_role,
    sort: filter_sort,
    direction: filter_direction
} %}

{% set nextDir = {
    'created_at': filter_sort == 'created_at' and filter_direction == 'ASC' ? 'DESC' : 'ASC',
    'first_name': filter_sort == 'first_name' and filter_direction == 'ASC' ? 'DESC' : 'ASC',
    'last_name': filter_sort == 'last_name' and filter_direction == 'ASC' ? 'DESC' : 'ASC',
    'email': filter_sort == 'email' and filter_direction == 'ASC' ? 'DESC' : 'ASC'
} %}

<div class="user-table-card">
        <table class="table-simple">
            <thead>
                <tr>
                    <th><a href="{{ path('app_backoffice_users', baseParams|merge({sort:'first_name', direction: nextDir['first_name']})) }}" class="sortable">Prenom</a></th>
                    <th><a href="{{ path('app_backoffice_users', baseParams|merge({sort:'last_name', direction: nextDir['last_name']})) }}" class="sortable">Nom</a></th>
                    <th><a href="{{ path('app_backoffice_users', baseParams|merge({sort:'email', direction: nextDir['email']})) }}" class="sortable">Email</a></th>
                    <th>Téléphone</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th>Actif</th>
                    <th><a href="{{ path('app_backoffice_users', baseParams|merge({sort:'created_at', direction: nextDir['created_at']})) }}" class="sortable">Créé le</a></th>
                    <th>Maj le</th>
                    <th style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                {% set role_class = user.role|lower == 'admin' ? 'admin' : (user.role|lower == 'recruiter' ? 'recruiter' : 'candidate') %}
                {% set active = user.isActive ?? user.active ?? true %}
                <tr>
                    <td>{{ user.firstName ?? user.first_name ?? '' }}</td>
                    <td>{{ user.lastName ?? user.last_name ?? '' }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.phone ?? '' }}</td>
                    <td><span class="badge-role {{ role_class }}">{{ user.role|upper }}</span></td>
                    <td><span class="badge-status">{{ (user.status ?? user.verify ?? 'Vérifie')|capitalize }}</span></td>
                    <td><span class="badge-active">{{ active ? 'Actif' : 'Inactif' }}</span></td>
                    <td>{{ user.createdAt is defined and user.createdAt ? user.createdAt|date('d-m-y H:i') : (user.created ?? '') }}</td>
                    <td>{{ user.updatedAt is defined and user.updatedAt ? user.updatedAt|date('d-m-y H:i') : (user.updated ?? '') }}</td>
                    <td>
                          {% set uid = user.id ?? user.id_user ?? null %}
                          <div class="actions-inline">
                            {% if uid %}
                              <a class="btn btn-ghost" aria-label="Edit" href="{{ path('app_backoffice_users_edit', {id: uid}) }}">Edit</a>
                              <form method="post" action="{{ path('app_backoffice_users_delete', {id: uid}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?');">
                                  <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ uid) }}">
                                  <button type="submit" class="btn btn-ghost" aria-label="Delete">Delete</button>
                              </form>
                            {% else %}
                              <span class="text-muted">–</span>
                            {% endif %}
                          </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10" style="text-align:center; color:var(--muted); padding:16px;">Aucun utilisateur ne correspond à ces filtres.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
